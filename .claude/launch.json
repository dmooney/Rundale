{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vite-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "limerick/apps/ui",
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "limerick-web",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": ["-c", "source $HOME/.cargo/env && cargo run -- --web"],
      "cwd": "limerick",
      "port": 3001
    },
    {
      "name": "limerick-e2e",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "source $HOME/.cargo/env && cargo run -- --web 3099"
      ],
      "cwd": "limerick",
      "port": 3099
    },
    {
      "name": "bench-site-v2",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev", "--port", "4321"],
      "cwd": "promptfoo/bench-site",
      "port": 4321
    },
    {
      "name": "harness-dashboard",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "source $HOME/.cargo/env && cargo run -p limerick-harness -- serve --port 8787"
      ],
      "cwd": "limerick",
      "port": 8787
    }
  ]
}
