# Limerick — Environment Configuration
# Copy this file to .env and fill in your values.
# .env is gitignored and will not be committed.

# ─── Local / primary provider ────────────────────────────────────────────────

# Provider: simulator (default), ollama, lmstudio, vllm, openrouter, openai, anthropic,
#           google, groq, xai, mistral, deepseek, together, nvidia-nim, custom
LIMERICK_PROVIDER=openrouter

# API keys — use the standard env var for each provider you enable.
# Limerick reads these directly; no LIMERICK_API_KEY wrapper needed.
# Set only the key(s) for providers you actually use.
#
# WHEN ADDING A NEW PROVIDER: add its key var here and in
# Provider::api_key_env_var() in crates/limerick-config/src/provider.rs.
#
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# TOGETHER_API_KEY=
# NVIDIA_API_KEY=
# COHERE_API_KEY=
# MOONSHOT_API_KEY=
# QWEN_API_KEY=
# SCALEWAY_API_KEY=
# SILICONFLOW_API_KEY=
# VERCEL_API_KEY=
# ZHIPU_API_KEY=
# GITHUB_TOKEN=              # github_models provider
# OPENCODE_API_KEY=          # https://opencode.ai/zen/go/v1 (Kimi, Qwen, GLM, DeepSeek, MiniMax, MiMo)

# Model name (required for non-ollama providers)
# Each provider has its own model naming — examples:
#   openrouter: google/gemma-3-1b-it:free  (see https://openrouter.ai/models)
#   openai:     gpt-4o-mini
#   anthropic:  claude-haiku-4-5
#   google:     gemini-2.0-flash
#   groq:       llama-3.3-70b-versatile
#   xai:        grok-3-mini
#   mistral:    mistral-small-latest
#   deepseek:   deepseek-chat
#   together:   meta-llama/Llama-3.3-70B-Instruct-Turbo
#   nvidia-nim: nvidia/nemotron-3-super-120b-a12b
LIMERICK_MODEL=google/gemma-3-1b-it:free

# Base URL override (optional — defaults are set per provider)
# LIMERICK_BASE_URL=https://openrouter.ai/api

# Ollama debug/testing: delete the selected local model before pulling it again.
# LIMERICK_OLLAMA_FORCE_REDOWNLOAD=1

# ─── Per-category overrides (optional) ───────────────────────────────────────
# Route a specific inference category to a different provider/model.
# The API key is always read from the provider's standard env var above —
# no per-category API_KEY vars exist (they were removed to prevent key leakage).
#
# LIMERICK_DIALOGUE_PROVIDER=anthropic
# LIMERICK_DIALOGUE_MODEL=claude-opus-4-7
# LIMERICK_DIALOGUE_BASE_URL=
#
# LIMERICK_SIMULATION_PROVIDER=
# LIMERICK_INTENT_PROVIDER=
# LIMERICK_REACTION_PROVIDER=

# ─── Legacy cloud dialogue config (optional) ─────────────────────────────────
# Older single-cloud pathway, superseded by per-category overrides above.
# API key comes from the provider's standard env var (e.g. OPENROUTER_API_KEY).
# LIMERICK_CLOUD_PROVIDER=openrouter
# LIMERICK_CLOUD_MODEL=
# LIMERICK_CLOUD_BASE_URL=

# ─── Gameplay / runtime ──────────────────────────────────────────────────────

# DANGER: path to a mod directory for the normalize-mod-source script.
# Running `limerick/scripts/normalize-mod-source.sh <dir>` sets this env var
# and invokes the gated integration test that rewrites JSON files in-place.
# Never point this at a directory with real production content.
# LIMERICK_NORMALIZE_MOD_DIR=

# Enable improv craft mode for NPC dialogue
# LIMERICK_IMPROV=1

# Path to a game mod directory (defaults to auto-detecting mods/rundale/)
# LIMERICK_MOD=mods/rundale

# ─── Web server — Cloudflare Access (production auth) ────────────────────────

# Cloudflare Access JWT validation — required for production deployments behind
# Cloudflare Access. When CF_ACCESS_AUD is unset, the server rejects ALL
# requests in release builds (fail-closed). See limerick-server/src/cf_auth.rs.
# CF_ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
# CF_ACCESS_AUD=<your-application-audience-tag>

# ─── Web server — proxy trust ─────────────────────────────────────────────────

# Set to 1 when running behind a trusted reverse proxy (nginx, Cloudflare, etc.)
# that injects X-Forwarded-For. Enables IP-rate-limiter to see real client IPs.
# Do NOT set in environments where clients can forge X-Forwarded-For headers.
# LIMERICK_TRUST_PROXY=1

# ─── Web server (limerick-server) ───────────────────────────────────────────────

# Public base URL of the web server. Used to build the OAuth callback URL
# and must match what is registered in Google Cloud Console.
# Preferred over LIMERICK_BASE_URL for OAuth so inference and server URLs
# can differ (e.g. LIMERICK_BASE_URL points to an LLM API while
# LIMERICK_PUBLIC_URL points to your own server).
# LIMERICK_PUBLIC_URL=http://localhost:3001

# Google OAuth credentials — if either is unset, OAuth is silently disabled
# and /auth/login/google is not registered. See docs/oauth-setup.md.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# WebSocket session signing key. REQUIRED for release builds; debug builds
# fall back to a random ephemeral key with a warning.
# LIMERICK_WS_SIGNING_KEY=

# Comma-separated list of emails allowed to run admin commands
# (e.g. /admin …). Unset means no user has admin privileges.
# LIMERICK_ADMIN_EMAILS=operator@example.com
