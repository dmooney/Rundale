parish/target/
.parish-graphical-harness-target/
# Node modules anywhere (root tooling package, ui app, bench site)
node_modules/
parish/node_modules/
# Python dev-tooling virtualenv (ruff/mypy/yamllint/pytest)
.venv-dev/
*.swp
*.swo
*~
__pycache__/
*.py[cod]
# Python dev-tool caches (pytest/mypy/ruff)
.pytest_cache/
.mypy_cache/
.ruff_cache/
.env
*.db
*.db-journal
*.db-wal
logs/
.claude/worktrees
parish/apps/ui/dist/
test-results/
claude/*
.worktrees
saves
.DS_store

# Python local tooling
.venv*/

# Graphify knowledge graphs are reproducible local indexes, not repository
# source. This component-level rule covers root and nested scans.
**/graphify-out/

# Proof bundles — written by /task-start and the live-proof skills.
# Bundles are attached to PRs via `just attach-proof`, not committed.
/.proofs/

# Historical proof receipts and generated benchmark output are local archives,
# not repository source. On the primary macOS workstation these paths are
# symlinked into iCloud Drive/Rundale/proofs/.
/docs/proofs
/promptfoo/output

# Tauri-generated schema files — auto-generated by tauri-build, not hand-edited.
parish/crates/parish-tauri/gen/schemas/

# act (local GitHub Actions runner) — secrets file and artifact outputs.
# Artifact output lives at /tmp/act-artifacts (set in .actrc) — outside
# the repo, but guard against stray relative-path writes just in case.
# See .secrets.example and docs/agent/act-local.md.
.secrets
act-artifacts/

.gemini/
# Autogenerated Codex worktree-environment metadata; may copy a local `.env`.
.codex/environments/
gha-creds-*.json

# Local configuration — may contain API keys (Gemini, Ollama, etc.)
# See parish.example.toml for the expected structure.
parish.toml

# Bundled vllm-mlx Python runtime produced by `just build-vllm-mlx-bundle`.
# Contents are large (~360 MB compressed, ~1.5 GB unpacked) and built
# fresh per release. The empty `python-runtime/` dir (with a .gitkeep)
# is tracked so tauri-build's resource glob doesn't reject dev runs
# that skip the bundle step.
parish/dist/vllm-mlx/python-runtime/*
!parish/dist/vllm-mlx/python-runtime/.gitkeep
parish/dist/cpython-*.tar.gz
parish/dist/cpython-*.tar.zst
parish/dist/vllm-mlx-bundle.tar.zst
parish/dist/vllm-mlx-bundle.tar.zst.sha256

# MCP backend runtime files (created by parish-mcp-backend.sh)
parish/.parish-mcp-backend.log
parish/.parish-mcp-backend.pid

# Demo auto-player log (created by `just demo`).
parish/.demo-run.log

# Per-session runtime lock written by Claude Code's scheduled-tasks system.
.claude/scheduled_tasks.lock

# Optional bundled tile directory consumed by TileCache.bundled_dir fallback.
# Empty in tree — populate locally if/when a tile bundle becomes available.
mods/rundale/tiles/

# mlx_lm.server stdout/stderr captured by rundale-bench/local_runner.py per
# sweep. Verbose, regenerated on every run, and not useful long-term — the
# scored run JSONs alongside it are the durable artifact.
rundale-bench/artifacts/local_logs/

# Transient subagent judging queue (rundale-bench). Bundles + done results are
# regenerated per run; only the committed judgment cache under
# docs/proofs/rundale-bench/judgments/ is durable.
rundale-bench/.bench-queue/

# Stray rustc/clippy compile experiments left at the repo root or in a crate
# dir (e.g. `rustc --test -o libtest_foo`). Never committed — cargo output
# lives under target/.
*.rlib

# Workflow scripts auto-persisted by Claude Code's Workflow tool when a
# workflow-backed skill runs. Generated per session, not source.
.claude/workflows/

# Worktree metadata files (gitdir overlapping worktree root) — never track
COMMIT_EDITMSG
HEAD
ORIG_HEAD
commondir
gitdir
index
index.lock

# cargo-tarpaulin coverage artifacts
*.profraw

# Local pnpm content-addressed package store
.pnpm-store/
