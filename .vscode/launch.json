{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug (limerick)",
      "cargo": {
        "args": [
          "build",
          "--manifest-path=${workspaceFolder}/limerick/Cargo.toml",
          "--bin=limerick-engine",
          "--package=limerick-engine"
        ],
        "filter": {
          "name": "limerick",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}/limerick",
      "env": {
        "RUST_LOG": "debug"
      },
      "terminal": "integrated"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Release (limerick)",
      "cargo": {
        "args": [
          "build",
          "--release",
          "--manifest-path=${workspaceFolder}/limerick/Cargo.toml",
          "--bin=limerick-engine",
          "--package=limerick-engine"
        ],
        "filter": {
          "name": "limerick",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}/limerick",
      "env": {
        "RUST_LOG": "info"
      },
      "terminal": "integrated"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug Tests",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "--manifest-path=${workspaceFolder}/limerick/Cargo.toml",
          "--lib",
          "--package=limerick-engine"
        ],
        "filter": {
          "kind": "lib"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}/limerick",
      "env": {
        "RUST_LOG": "debug"
      }
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug Single Test",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "--manifest-path=${workspaceFolder}/limerick/Cargo.toml",
          "--lib",
          "--package=limerick-engine"
        ],
        "filter": {
          "kind": "lib"
        }
      },
      "args": ["${input:testName}"],
      "cwd": "${workspaceFolder}/limerick",
      "env": {
        "RUST_LOG": "debug"
      }
    }
  ],
  "inputs": [
    {
      "id": "testName",
      "description": "Name of the test to debug",
      "type": "promptString",
      "default": ""
    }
  ]
}
