---
import Base from '../layouts/Base.astro';
import data from '../data/bench.json';
const rows = data.gaeilge ?? [];
const AXES = ['fluency', 'grammar', 'idiom', 'task_fulfillment', 'english_leakage'];
const fmt = (v) => (typeof v === 'number' ? v.toFixed(2) : '—');
---
<Base title="Rundale Bench — Gaeilge fluency">
  <h2>Irish (Gaeilge) fluency</h2>
  <p class="muted">
    Eleven prompts test natural Irish syntax, idiom, and task-fulfilment. Axes
    are 1–5 means. <strong>english_leakage</strong> is scored 5 = stayed in
    Irish, 1 = fell back to English. NPC dialogue in Rundale code-switches
    en-IE / ga-IE, so a model with strong dialogue scores can still fail here.
  </p>
  <p class="muted">
    Judged by <span class="badge">⚖ judge_gaeilge_v1 (claude-sonnet-4-6)</span>.
    Rubric: knows Standard Irish + Connacht dialect; rejects English
    explanations, Scots Gaelic, Welsh, or pseudo-Irish word-strings; tolerates
    dialect variation, missing fadas, and proper names.
  </p>
  {rows.length === 0 ? (
    <div class="empty">No gaeilge runs yet. Run the gaeilge slice and ingest.</div>
  ) : (
    <table>
      <thead>
        <tr>
          <th>Model</th>
          <th class="num">Overall</th>
          {AXES.map((a) => <th class="num">{a}</th>)}
          <th class="num">leakage %</th>
          <th class="num">n</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <td>{r.model_id} {r.family !== 'unknown' && <span class="badge">{r.family}</span>}</td>
            <td class="num"><strong>{fmt(r.overall)}</strong></td>
            {AXES.map((a) => <td class="num">{fmt(r[a])}</td>)}
            <td class="num">{fmt((r.english_leakage_flag_rate ?? 0) * 100)}%</td>
            <td class="num">{r.records ?? '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
</Base>
