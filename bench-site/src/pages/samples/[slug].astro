---
import Base from '../../layouts/Base.astro';
import SamplesBrowser from '../../components/SamplesBrowser.svelte';
import data from '../../data/bench.json';
const base = import.meta.env.BASE_URL;

export function getStaticPaths() {
  return Object.values(data.samples ?? {}).map((m) => ({
    params: { slug: m.slug },
    props: { model: m },
  }));
}
const { model } = Astro.props;
---
<Base title={`Rundale Bench — ${model.model_id} samples`}>
  <p><a href={base}>← leaderboard</a></p>
  <h2>{model.model_id} — dialogue samples</h2>
  <p class="muted">
    {model.items.length} prompt(s) · judged by <strong>{model.judge_id}</strong>
    {model.judge_model && model.judge_model !== model.judge_id ? `(${model.judge_model})` : ''}
    · run {new Date(model.measured_utc).toISOString().slice(0, 10)}.
    Per-prompt scores are inline; click <strong>full</strong> to see the entire reply.
  </p>
  <SamplesBrowser client:load items={model.items} />
</Base>
