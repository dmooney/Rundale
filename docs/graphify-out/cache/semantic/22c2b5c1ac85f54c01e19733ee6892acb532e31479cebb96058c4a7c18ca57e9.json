{"nodes": [{"id": "input_enrichment_02_emote_actions_action_syntax", "label": "Emote actions use matched asterisks to distinguish physical behavior from speech, render action segments in italics, and allow pure action or mixed action-plus-dialogue turns.", "file_type": "document", "source_file": "design/input-enrichment/02-emote-actions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "input_enrichment_02_emote_actions_enriched_input", "label": "The backend extraction design produces EnrichedInput with raw text, optional dialogue, a list of action descriptions, and an optional mention target.", "file_type": "concept", "source_file": "design/input-enrichment/02-emote-actions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "input_enrichment_02_emote_actions_prompt_framing", "label": "Prompt assembly explicitly frames pure actions as physical rather than spoken, combines actions and quoted dialogue when both exist, and classifies pure actions as interaction intent.", "file_type": "concept", "source_file": "design/input-enrichment/02-emote-actions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "input_enrichment_02_emote_actions_unmatched_text_safety", "label": "Only complete nonempty asterisk pairs become actions; unmatched asterisks remain literal text, preserving ordinary input and preventing partial markup from changing intent.", "file_type": "rationale", "source_file": "design/input-enrichment/02-emote-actions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "input_enrichment_02_emote_actions_action_syntax", "target": "input_enrichment_02_emote_actions_enriched_input", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/input-enrichment/