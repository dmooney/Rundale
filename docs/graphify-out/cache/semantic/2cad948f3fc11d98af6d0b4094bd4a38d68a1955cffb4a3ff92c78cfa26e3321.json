{"nodes": [{"id": "input_enrichment_05_whisper_syntax_private_conversation", "label": "Whisper syntax is a medium-effort private-conversation design supporting both @Name (whisper) message and greater-than-Name message forms with distinct chat rendering.", "file_type": "document", "source_file": "design/input-enrichment/05-whisper-syntax.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "input_enrichment_05_whisper_syntax_end_to_end_metadata", "label": "Whisper and target metadata must flow through frontend submission, shared IPC payloads, server routing, text-log events, NPC inference framing, and persisted memories.", "file_type": "concept", "source_file": "design/input-enrichment/05-whisper-syntax.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "input_enrichment_05_whisper_syntax_private_memory_filter", "label": "The target NPC retains private memories for direct Tier 1 recall, while public context builders, Tier 2 simulation, overhearing, and other present NPCs must exclude those entries to prevent leakage.", "file_type": "concept", "source_file": "design/input-enrichment/05-whisper-syntax.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "input_enrichment_05_whisper_syntax_privacy_correctness", "label": "Frontend parsing is simple, but privacy is a backend correctness property requiring absent-target handling, private-memory persistence, and integration tests proving that bystanders never learn the exchange.", "file_type": "rationale", "source_file": "design/input-enrichment/05-whisper-syntax.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "input_enrichment_05_whisper_syntax_private_conversation", "target": "input_enrichment_05_whisper_syntax_end_to_end_metadata", "relation": "implem