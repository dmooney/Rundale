{"nodes": [{"id": "plans_gemma4_rundale_training_plan_gemma_four_training_plan", "label": "Gemma 4 Rundale Training Plan", "file_type": "document", "source_file": "plans/gemma4-rundale-training-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proposed training, evaluation, serving, provenance, and cost plan for a Rundale-specific 1820s dialogue model."}, {"id": "plans_gemma4_rundale_training_plan_proposed_status", "label": "Proposed Training Status", "file_type": "concept", "source_file": "plans/gemma4-rundale-training-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The plan is explicitly proposed rather than implemented."}, {"id": "plans_gemma4_rundale_training_plan_gemma_nine_b_qlora", "label": "Gemma 4 9B QLoRA", "file_type": "concept", "source_file": "plans/gemma4-rundale-training-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stage 1 fine-tunes the instruction-tuned 9B base with QLoRA."}, {"id": "plans_gemma4_rundale_training_plan_iterated_dpo", "label": "Iterated Direct Preference Optimization", "file_type": "concept", "source_file": "plans/gemma4-rundale-training-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stage 2 uses eight candidates and two or three DPO rounds to prefer historically grounded dialogue."}, {"id": "plans_gemma4_rundale_training_plan_four_axis_judge_stack", "label": "Four-Axis Judge Stack", "file_type": "concept", "source_file": "plans/gemma4-rundale-training-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anachronism, Talkie likelihood, a 250M dialect oracle, and DeepSeek coherence are combined by Borda ranking."}, {"id": "plans_gemma4_rundale_training_plan_quality_tiered_corpus", "label": "Quality-Tiered Source Corpus", "file_type": "rationale", "source_file": "plans/gemma4-rundale-training-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "S/A/B/C source tiers weight geographic, period, social-class, and peasant-speech density rather than treating sources equally."}, {"id": "plans_gemma4_rundale_training_plan_feature_substrate_floor", "label": "Feature-Tagged Substrate Floor", "file_type": "rationale", "source_file": "plans/gemma4-rundale-training-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A mandatory feature tagger and evidence-based class assignment prevent dialect targets from resting on unverified labels."}, {"id": "plans_gemma4_rundale_training_plan_stage_irish_negative_pool", "label": "Stage-Irish Negative Preference Pool", "file_type": "rationale", "source_file": "plans/gemma4-rundale-training-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stereotyped stage-Irish examples are used only as rejected DPO candidates, never as positive training targets."}, {"id": "plans_gemma4_rundale_training_plan_judge_calibration_gate", "label": "Judge Calibration Gate", "file_type": "rationale", "source_file": "plans/gemma4-rundale-training-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each judge is calibrated on 200 synthetic pairs and must reach 80 percent before use, with model-based fallbacks."}, {"id": "plans_gemma4_rundale_training_plan_background_lane_critic", "label": "Background-Lane Critic", "file_type": "rationale", "source_file": "plans/gemma4-rundale-training-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The serving design emits a fast draft, evaluates alternates off the inline path, and silently replaces within a 1.5-second cap."}, {"id": "plans_gemma4_rundale_training_plan_runpod_a100_budget", "label": "RunPod A100 Budget Envelope", "file_type": "concept", "source_file": "plans/gemma4-rundale-training-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The primary run targets an A100 80GB, roughly 24 to 38 hours, a 100-dollar cap, and teardown after completion or failure."}, {"id": "plans_gemma4_rundale_training_plan_reproducible_model_package", "label": "Reproducible Model Package", "file_type": "concept", "source_file": "plans/gemma4-rundale-training-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliverables include GGUF and Ollama packaging, provenance, model and data cards, checkpoints, logs, and reproducibility tiers."}, {"id": "plans_gemma4_rundale_training_plan_licensing_exclusions", "label": "Licensing and Access Exclusions", "file_type": "rationale", "source_file": "plans/gemma4-rundale-training-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "D\u00fachas, paid papers, and on-site-only sources are excluded when licensing, robots, or access conditions do not permit ingestion."}, {"id": "plans_gemma4_rundale_training_plan_bilingual_phase_split", "label": "Bilingual Phase Split", "file_type": "concept", "source_file": "plans/gemma4-rundale-training-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Open notes separate an English-first phase with limited Gaeilge replay from a later full Gaeilge and code-switching phase."}], "edges": [{"source": "plans_gemma4_rundale_training_plan_gemma_four_training_plan", "target": "plans_gemma4_rundale_training_plan_proposed_sta