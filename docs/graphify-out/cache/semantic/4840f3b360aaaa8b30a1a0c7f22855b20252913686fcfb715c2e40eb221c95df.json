{"nodes": [{"id": "ideas_rag_lore_recall_proposed_and_parked", "label": "RAG Lore Recall is proposed but parked behind the emotion-system work; it grounds Tier 1 NPC dialogue in authored parish JSON lore rather than model memory or four fixed NPC knowledge bullets.", "file_type": "document", "source_file": "design/ideas/rag-lore-recall.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ideas_rag_lore_recall_lore_index", "label": "A standalone parish-rag crate builds roughly 280 one-fact LoreChunks from world, NPC, and festival data, embeds them once, performs in-memory cosine top-k retrieval, and formats a KNOWLEDGE YOU RECALL block.", "file_type": "concept", "source_file": "design/ideas/rag-lore-recall.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ideas_rag_lore_recall_query_time_context", "label": "The dialogue caller asynchronously embeds the current player query and passes the vector and shared index into otherwise-synchronous per-turn context assembly, placing lore recall beside but distinct from personal long-term memory.", "file_type": "rationale", "source_file": "design/ideas/rag-lore-recall.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ideas_rag_lore_recall_deterministic_and_semantic_embedders", "label": "HashEmbedder is the reproducible offline default but only lexical; OllamaEmbedder is the opt-in semantic path, while current limitations include no reload rebuild, no per-NPC lore scoping, and linear search.", "file_type": "concept", "source_file": "design/ideas/rag-lore-recall.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "ideas_rag_lore_recall_proposed_and_parked", "target": "ideas_rag_lore_recall_lore_index", "relation": "implements", "confidence": "EXTRACTED", "con