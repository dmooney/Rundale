{"nodes": [{"id": "ideas_visual_effects_system_proposed_css_system", "label": "The proposed visual-effects system uses Svelte, CSS, and SVG rather than WebGL, canvas, video, or external animation dependencies to make a text-first interface visibly respond to the world.", "file_type": "document", "source_file": "design/ideas/visual-effects-system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ideas_visual_effects_system_state_driven_effect_manager", "label": "A central effect store, pure trigger evaluators, cooldown registry, conflict suppression, and top-level pointer-transparent EffectsLayer convert WorldSnapshot and text-log changes into self-removing viewport effects.", "file_type": "concept", "source_file": "design/ideas/visual-effects-system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ideas_visual_effects_system_effect_catalogue", "label": "The catalogue spans lightning, rain, fog, aurora, bog lights, a visiting fairy, wind-shuddered text, embers, frost, day-shift pulses, festival candlelight, dusk crows, and emotion-linked ink bleed.", "file_type": "concept", "source_file": "design/ideas/visual-effects-system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ideas_visual_effects_system_accessibility_contract", "label": "Effects must never obscure text, are infrequent and state-grounded, respect prefers-reduced-motion with static fallbacks or omission, and ultimately expose On, Minimal, and Off player settings.", "file_type": "rationale", "source_file": "design/ideas/visual-effects-system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "ideas_visual_effects_system_proposed_css_system", "target": "ideas_visual_effects_system_state_driven_effect_manager", "relation": "impleme