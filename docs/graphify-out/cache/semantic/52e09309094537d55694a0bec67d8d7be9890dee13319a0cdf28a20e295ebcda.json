{"nodes": [{"id": "ideas_npc_sleep_dream_consolidation_deferred_status", "label": "NPC sleep and dream consolidation is explicitly deferred until the structured emotion system lands and completes human playtest because both designs overlap in state, ticks, prompts, persistence, and tuning.", "file_type": "document", "source_file": "design/ideas/npc-sleep-dream-consolidation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ideas_npc_sleep_dream_consolidation_sleep_and_fatigue", "label": "The medium-scope sleep model adds an orthogonal sleep state and a clamped fatigue scalar, detects individual schedule transitions into and out of sleeping, and applies exhaustion consequences.", "file_type": "concept", "source_file": "design/ideas/npc-sleep-dream-consolidation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ideas_npc_sleep_dream_consolidation_hierarchical_memory", "label": "At each NPC's sleep-window end, an asynchronous dream pass summarizes recent short-term memories, promotes never-compacted core memories, and recursively compacts nightly summaries into week-, month-, and season-scale reflections.", "file_type": "concept", "source_file": "design/ideas/npc-sleep-dream-consolidation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ideas_npc_sleep_dream_consolidation_emotion_dependency", "label": "Deferral is primarily semantic: fatigue should bias emotional reactivity and dream content should use emotional state, while high-intensity emotional events provide the strongest core-memory promotion signal.", "file_type": "rationale", "source_file": "design/ideas/npc-sleep-dream-consolidation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "ideas_npc_sleep_dream_consolidation_deferred_stat