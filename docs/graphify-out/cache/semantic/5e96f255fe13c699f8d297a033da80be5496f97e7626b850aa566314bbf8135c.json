{"nodes": [{"id": "ideas_music_sound_brainstorm_creative_vision", "label": "The music and sound document is a creative brainstorm, not the technical architecture, defining how silence, ambience, music, propagation, weather, calendar, and folklore should make the text world feel inhabited.", "file_type": "document", "source_file": "design/ideas/music-sound-brainstorm.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ideas_music_sound_brainstorm_living_soundscape", "label": "A living soundscape layers location ambience, scheduled time-of-day cues, weather transformation, graph-distance propagation, indoor thresholds, and seasonal density so sound communicates world state.", "file_type": "concept", "source_file": "design/ideas/music-sound-brainstorm.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ideas_music_sound_brainstorm_ambiguous_otherworld", "label": "Supernatural sound must remain rare and naturally deniable: fairy music, banshee keening, p\u00faca hoofbeats, water-horse breathing, bog voices, and festival shifts provide ambiguity rather than confirmation.", "file_type": "rationale", "source_file": "design/ideas/music-sound-brainstorm.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ideas_music_sound_brainstorm_harp_signal", "label": "The wire-strung harp is historically extinct in living 1820 practice and is reserved exclusively as a sonic signal of the s\u00eddhe; ordinary human music uses the period social palette of fiddle, pipes, flute, whistle, voice, and jaw harp.", "file_type": "concept", "source_file": "design/ideas/music-sound-brainstorm.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "ideas_music_sound_brainstorm_creative_vision", "target": "ideas_music_sound_brainstorm