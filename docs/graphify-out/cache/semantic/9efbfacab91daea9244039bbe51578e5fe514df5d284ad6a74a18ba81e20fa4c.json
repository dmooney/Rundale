{"nodes": [{"id": "ideas_emotion_driven_dialogue_and_simulation_brainstorm", "label": "Emotion-driven dialogue and simulation is a brainstorm for a structured affect layer that influences both moment-to-moment speech and longer-running NPC behavior.", "file_type": "document", "source_file": "design/ideas/emotion-driven-dialogue-and-simulation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ideas_emotion_driven_dialogue_and_simulation_affective_state", "label": "The proposed deterministic emotional state combines valence, arousal, dominance, social warmth, and stress load with curated human-readable labels and appraisal tags.", "file_type": "concept", "source_file": "design/ideas/emotion-driven-dialogue-and-simulation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ideas_emotion_driven_dialogue_and_simulation_dialogue_policy", "label": "A dialogue-policy selector maps affect and social appraisal to bounded strategies such as de-escalate, probe, deflect, bond, withdraw, or confront, then lets archetype style shape the expression.", "file_type": "concept", "source_file": "design/ideas/emotion-driven-dialogue-and-simulation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ideas_emotion_driven_dialogue_and_simulation_safe_rollout", "label": "The recommended rollout starts with a small label-plus-intensity model and six dialogue policies, exposes hidden structured fields and risk flags, and evaluates stability before adding contagion, memory, and simulation gates.", "file_type": "rationale", "source_file": "design/ideas/emotion-driven-dialogue-and-simulation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "ideas_emotion_driven_dialogue_and_simulation_brainstorm", "target": "ideas_emotion_