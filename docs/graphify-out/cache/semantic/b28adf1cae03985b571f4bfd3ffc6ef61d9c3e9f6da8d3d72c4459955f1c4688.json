{"nodes": [{"id": "input_enrichment_03_input_history_frontend_design", "label": "Input history is a frontend-only shell-style navigation design that persists up to fifty submitted entries in localStorage and silently degrades to session-only behavior when storage is unavailable.", "file_type": "document", "source_file": "design/input-enrichment/03-input-history.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "input_enrichment_03_input_history_navigation_contract", "label": "Arrow Up and Down traverse oldest-to-newest history without wrapping, preserve and restore the current draft, reset on manual edits or submit, and recall mentions as plain text rather than reconstructing stale chips.", "file_type": "concept", "source_file": "design/input-enrichment/03-input-history.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "input_enrichment_03_input_history_cursor_precedence", "label": "History interception yields to mention or slash dropdowns and, for multiline content, activates Up only on the first line and Down only on the last line so normal cursor movement remains available.", "file_type": "rationale", "source_file": "design/input-enrichment/03-input-history.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "input_enrichment_03_input_history_frontend_design", "target": "input_enrichment_03_input_history_navigation_contract", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/input-enrichment/03-input-history.md", "source_location": null, "weight": 1.0}, {"source": "input_enrichment_03_input_history_cursor_precedence", "target": "input_enrichment_03_input_history_navigation_contract", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/input-enrichment/03-