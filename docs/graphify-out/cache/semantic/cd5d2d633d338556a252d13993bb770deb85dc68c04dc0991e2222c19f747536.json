{"nodes": [{"id": "input_enrichment_01_slash_autocomplete_frontend_design", "label": "Slash autocomplete is a low-effort frontend design that reuses mention-dropdown infrastructure to filter, describe, navigate, and insert valid system commands beginning at input position zero.", "file_type": "document", "source_file": "design/input-enrichment/01-slash-autocomplete.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "input_enrichment_01_slash_autocomplete_command_registry", "label": "A static CommandDescriptor registry supplies names, descriptions, argument hints, debug visibility, and dynamically crossed provider, model, and key commands for dialogue, simulation, and intent categories.", "file_type": "concept", "source_file": "design/input-enrichment/01-slash-autocomplete.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "input_enrichment_01_slash_autocomplete_cosmetic_boundary", "label": "The registry is intentionally frontend-only because backend command parsing already exists; a server-driven registry is deferred until commands become mod-driven or runtime-dynamic.", "file_type": "rationale", "source_file": "design/input-enrichment/01-slash-autocomplete.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "input_enrichment_01_slash_autocomplete_frontend_design", "target": "input_enrichment_01_slash_autocomplete_command_registry", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/input-enrichment/01-slash-autocomplete.md", "source_location": null, "weight": 1.0}, {"source": "input_enrichment_01_slash_autocomplete_cosmetic_boundary", "target": "input_enrichment_01_slash_autocomplete_frontend_design", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/input-e