{"nodes": [{"id": "ideas_night_visions_parked_status", "label": "Night Visions is parked after a shelved prototype because player fatigue, housing, beds, warmth, exposure, and interruptions do not yet make sleep a meaningful gameplay choice.", "file_type": "document", "source_file": "design/ideas/night-visions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ideas_night_visions_deterministic_dream_generator", "label": "The design generates occasional deterministic player dreams from remembered places, current season and weather, the latest conversation figure, Irish folklore imagery, and a festival-specific coda.", "file_type": "concept", "source_file": "design/ideas/night-visions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ideas_night_visions_template_first_rationale", "label": "Pure templates are preferred initially because seeded output is reproducible, offline, fast, tone-bounded, testable, and able to fall back safely if an optional future LLM enrichment pass fails.", "file_type": "rationale", "source_file": "design/ideas/night-visions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ideas_night_visions_sleep_prerequisites", "label": "Fatigue and at least one player home are strict prerequisites; warmth, exposure, eligible sleep locations, interrupt hooks, and mythology-site probability bonuses complete the intended sleep contract.", "file_type": "concept", "source_file": "design/ideas/night-visions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "ideas_night_visions_parked_status", "target": "ideas_night_visions_deterministic_dream_generator", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/ideas/night-visions.md", "sourc