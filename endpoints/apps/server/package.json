{
  "name": "@limerick/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "NODE_OPTIONS=--conditions=source tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "definitions": "NODE_OPTIONS=--conditions=source tsx src/definitions.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "11.2.1",
    "@limerick/auth": "workspace:*",
    "@limerick/database": "workspace:*",
    "@limerick/domain": "workspace:*",
    "@limerick/observability": "workspace:*",
    "@limerick/providers": "workspace:*",
    "@limerick/runtime": "workspace:*",
    "@limerick/schemas": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "firebase-admin": "^14.5.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "tsx": "4.23.15"
  }
}
