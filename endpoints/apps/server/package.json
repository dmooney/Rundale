    "@parish/runtime": "workspace:*",
    "@parish/schemas": "workspace:*",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "firebase-admin": "^14.3.0",
    "pg": "8.23.0"
  },
