{
  "name": "limerick-endpoints",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @limerick/server --filter @limerick/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @limerick/database db:generate",
    "db:migrate": "pnpm --filter @limerick/database db:migrate",
    "db:seed": "pnpm --filter @limerick/database db:seed",
    "operator": "pnpm --filter @limerick/database operator",
    "definitions": "pnpm --filter @limerick/server definitions",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "4.1.12"
  }
}
