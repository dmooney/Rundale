{
  "name": "parish-endpoints",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @parish/server --filter @parish/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @parish/database db:generate",
    "db:migrate": "pnpm --filter @parish/database db:migrate",
    "db:seed": "pnpm --filter @parish/database db:seed",
    "operator": "pnpm --filter @parish/database operator",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.4",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.3.2",
    "prettier": "^3.8.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "4.1.11"
  }
}
