# Shape of save format 3. Recorded by limerick-core save_compat::tests::save_format_shape; never edit by hand.
[sqlite]
index idx_journal_branch_snap_seq: CREATE UNIQUE INDEX idx_journal_branch_snap_seq ON journal_events(branch_id, after_snapshot_id, sequence)
index idx_requests_branch_open: CREATE INDEX idx_requests_branch_open ON requests(branch_id, is_open)
index idx_transcript_events_branch_sequence: CREATE INDEX idx_transcript_events_branch_sequence ON transcript_events(branch_id, sequence)
index idx_transcript_events_event_id: CREATE UNIQUE INDEX idx_transcript_events_event_id ON transcript_events(event_id)
table branches: CREATE TABLE branches ( id INTEGER PRIMARY KEY, name TEXT UNIQUE NOT NULL, created_at TEXT NOT NULL, parent_branch_id INTEGER REFERENCES branches(id) )
table journal_events: CREATE TABLE journal_events ( id INTEGER PRIMARY KEY, branch_id INTEGER NOT NULL, sequence INTEGER NOT NULL, after_snapshot_id INTEGER NOT NULL REFERENCES snapshots(id), event_type TEXT NOT NULL, event_data TEXT NOT NULL, game_time TEXT NOT NULL )
table requests: CREATE TABLE requests ( request_id TEXT PRIMARY KEY, branch_id INTEGER NOT NULL REFERENCES branches(id) ON DELETE CASCADE, phase TEXT NOT NULL, is_open INTEGER NOT NULL, committed_revision INTEGER, record TEXT NOT NULL )
table snapshots: CREATE TABLE snapshots ( id INTEGER PRIMARY KEY, branch_id INTEGER NOT NULL REFERENCES branches(id), game_time TEXT NOT NULL, real_time TEXT NOT NULL, world_state TEXT NOT NULL )
table transcript_events: CREATE TABLE transcript_events ( sequence INTEGER PRIMARY KEY AUTOINCREMENT, event_id TEXT NOT NULL, branch_id INTEGER NOT NULL REFERENCES branches(id) ON DELETE CASCADE, request_id TEXT, kind TEXT NOT NULL, event TEXT NOT NULL )
user_version: 3
