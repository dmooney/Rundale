{
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "rundale-dialogue-input-v2",
    "title": "Rundale Endpoint invocation v2",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "endpointContractVersion": { "type": "integer", "enum": [2] },
      "contractVersion": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "major": { "type": "integer", "enum": [1] },
          "minor": { "type": "integer", "enum": [0] }
        },
        "required": ["major", "minor"]
      },
      "sessionID": { "type": "string", "minLength": 1, "maxLength": 200 },
      "logicalRequestID": { "type": "string", "minLength": 1, "maxLength": 200 },
      "attemptID": { "type": "string", "minLength": 1, "maxLength": 200 },
      "baseRevision": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rawValue": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        },
        "required": ["rawValue"]
      },
      "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 200 },
      "role": { "type": "string", "enum": ["npc_dialogue"] },
      "playerInput": { "type": "string", "minLength": 1, "maxLength": 4096 },
      "speaker": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
          "role": { "type": "string", "minLength": 1, "maxLength": 200 },
          "currentLocationId": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "currentLocationName": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "required": ["id", "displayName", "role", "currentLocationId", "currentLocationName"]
      },
      "currentLocation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "playable": { "type": "boolean" }
        },
        "required": ["id", "displayName", "description", "playable"]
      },
      "knownPeople": {
        "type": "array",
        "maxItems": 32,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 200 },
            "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
            "role": { "type": "string", "minLength": 1, "maxLength": 200 },
            "currentLocationId": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
            "currentLocationName": { "type": "string", "minLength": 1, "maxLength": 200 }
          },
          "required": ["id", "displayName", "role", "currentLocationId", "currentLocationName"]
        }
      },
      "knownPlaces": {
        "type": "array",
        "maxItems": 32,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 200 },
            "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
            "description": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "playable": { "type": "boolean" }
          },
          "required": ["id", "displayName", "description", "playable"]
        }
      },
      "authoredFacts": {
        "type": "array",
        "maxItems": 32,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 200 },
            "statement": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "source": { "type": "string", "minLength": 1, "maxLength": 200 }
          },
          "required": ["id", "statement", "source"]
        }
      },
      "acquiredKnowledge": {
        "type": "array",
        "maxItems": 32,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 300 },
            "proposition": { "type": "string", "minLength": 1, "maxLength": 512 },
            "knowingNpcID": { "type": "string", "minLength": 1, "maxLength": 200 },
            "classification": { "type": "string", "enum": ["heard_from_npc"] }
          },
          "required": ["id", "proposition", "knowingNpcID", "classification"]
        }
      },
      "rememberedPlayerClaims": {
        "type": "array",
        "maxItems": 32,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 300 },
            "proposition": { "type": "string", "minLength": 1, "maxLength": 512 },
            "knowingNpcID": { "type": "string", "minLength": 1, "maxLength": 200 },
            "classification": { "type": "string", "enum": ["player_claim"] }
          },
          "required": ["id", "proposition", "knowingNpcID", "classification"]
        }
      },
      "relevantTaskState": {
        "type": "array",
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 300 },
            "authoredTemplateID": { "type": "string", "minLength": 1, "maxLength": 200 },
            "status": { "type": "string", "enum": ["assigned", "in_progress", "completed"] }
          },
          "required": ["id", "authoredTemplateID", "status"]
        }
      },
      "recentConversation": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timestamp": { "type": "string", "minLength": 1, "maxLength": 64 },
            "location": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
            "speaker_id": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
            "speaker_name": { "type": "string", "minLength": 1, "maxLength": 200 },
            "player_input": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "npc_dialogue": { "type": "string", "minLength": 1, "maxLength": 8192 }
          },
          "required": ["timestamp", "location", "speaker_id", "speaker_name", "player_input", "npc_dialogue"]
        }
      },
      "maxOutputChars": { "type": "integer", "enum": [8192] },
      "maxStreamBytes": { "type": "integer", "enum": [16384] }
    },
    "required": [
      "endpointContractVersion", "contractVersion", "sessionID", "logicalRequestID",
      "attemptID", "baseRevision", "idempotencyKey", "role", "playerInput", "speaker",
      "currentLocation", "knownPeople", "knownPlaces", "authoredFacts", "acquiredKnowledge",
      "rememberedPlayerClaims", "relevantTaskState", "recentConversation", "maxOutputChars",
      "maxStreamBytes"
    ]
  },
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "rundale-dialogue-output-v2",
    "title": "Rundale NPC dialogue result v2",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "dialogue": { "type": "string", "minLength": 1, "maxLength": 8192 },
      "proposedPlayerMemory": {
        "type": ["object", "null"],
        "additionalProperties": false,
        "properties": {
          "claim": { "type": "string", "minLength": 1, "maxLength": 512 },
          "evidence": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "required": ["claim", "evidence"]
      },
      "authoredTaskOfferID": {
        "type": ["string", "null"],
        "minLength": 1,
        "maxLength": 200
      }
    },
    "required": ["dialogue"]
  },
  "instructions": "You are the Rundale NPC dialogue Endpoint, immutable contract version 2. Produce one brief grounded utterance in the named speaker's voice, using only the supplied grounding. Authored facts, acquired knowledge, remembered player claims, and task state are separate bounded evidence sets; never promote a player claim or heard report to authored truth, and only recall knowledge supplied for this speaker. When Peig hears the exact player words ‘I grew up in Athleague.’, respond naturally and propose exactly one player memory with claim ‘The player grew up in Athleague.’ and evidence ‘I grew up in Athleague.’. When Peig is at the Letter Office and the player asks whether she has work, offer delivery of a sealed letter to Róisín and return authoredTaskOfferID ‘task-deliver-peig-letter’. If relevantTaskState shows that task completed, Peig may acknowledge its completion. Otherwise omit both optional effects. Memory evidence must be an exact substring of playerInput and you must never invent a task ID. All effects are provisional proposals and Rust alone validates and commits them. Return only schema-valid JSON, with no markdown or stage directions.",
  "providerConfig": {
    "provider": "google",
    "model": "gemini-3.5-flash-lite"
  },
  "inferenceConfig": {
    "maxOutputTokens": 1024,
    "retryCount": 0,
    "streaming": { "version": 1, "textField": "dialogue" }
  }
}
