{"nodes": [{"id": "prompts_tier1_system_tier_1_character_role", "label": "Tier 1 Character Role", "file_type": "document", "source_file": "rundale/prompts/tier1_system.txt", "source_location": "lines 1-44", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The system prompt binds name, age, occupation, personality, guidance, and mood into a high-fidelity NPC role in 1820 County Roscommon."}, {"id": "prompts_tier1_system_occupational_knowledge_boundaries", "label": "Occupational Knowledge Boundaries", "file_type": "rationale", "source_file": "rundale/prompts/tier1_system.txt", "source_location": "STAY IN YOUR LANE", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NPCs redirect or admit ignorance outside the expertise of their authored occupation, preventing generic all-knowing characters."}, {"id": "prompts_tier1_system_1820_rural_roscommon_world_facts", "label": "1820 Rural Roscommon World Facts", "file_type": "concept", "source_file": "rundale/prompts/tier1_system.txt", "source_location": "WORLD FACTS and HISTORICAL CONTEXT", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The prompt fixes the political, educational, linguistic, agricultural, and technological conditions of Ireland in 1820, including emancipation and famine events that have not yet occurred."}, {"id": "prompts_tier1_system_historical_anachronism_guard", "label": "Historical Anachronism Guard", "file_type": "rationale", "source_file": "rundale/prompts/tier1_system.txt", "source_location": "WORLD FACTS, HISTORICAL CONTEXT, and REGISTER", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicit dates, unavailable technologies, travel and news constraints, and banned modern register keep NPC responses inside the 1820 setting."}, {"id": "prompts_tier1_system_dignified_irish_portrayal", "label": "Dignified Irish Character Portrayal", "file_type": "rationale", "source_file": "rundale/prompts/tier1_system.txt", "source_location": "CULTURAL GUIDELINES", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The prompt requires warm, intelligent, resilient, complex characters and forbids stage-Irish stereotypes involving drunkenness, violence, foolish superstition, or exaggerated dialect."}, {"id": "prompts_tier1_system_restricted_irish_phrase_vocabulary", "label": "Restricted Irish Phrase Vocabulary", "file_type": "rationale", "source_file": "rundale/prompts/tier1_system.txt", "source_location": "LANGUAGE", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only eight enumerated Irish expressions may be used verbatim; forbidding invented phrases and improvised grammar prevents fabricated Irish-language output."}, {"id": "prompts_tier1_system_hiberno_english_period_register", "label": "Hiberno-English Period Register", "file_type": "rationale", "source_file": "rundale/prompts/tier1_system.txt", "source_location": "LANGUAGE and REGISTER", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A restrained set of dialect markers and period equivalents produces regional voice while avoiding modern vocabulary and caricature."}, {"id": "prompts_tier1_system_conversation_farewell_discipline", "label": "Conversation Farewell Discipline", "file_type": "rationale", "source_file": "rundale/prompts/tier1_system.txt", "source_location": "NEVER FAREWELL MID-CONVERSATION", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parting phrases are reserved for an explicit player departure so an NPC does not accidentally close an ongoing conversation."}, {"id": "prompts_tier1_system_in_character_dialogue_only", "label": "In-Character Dialogue Only", "file_type": "rationale", "source_file": "rundale/prompts/tier1_system.txt", "source_location": "STAY IN CHARACTER", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The visible response contains only words spoken aloud, with no narration or action tags; physical behavior belongs in structured metadata."}, {"id": "prompts_tier1_system_concise_dialogue_contract", "label": "Concise Dialogue Contract", "file_type": "concept", "source_file": "rundale/prompts/tier1_system.txt", "source_location": "LENGTH", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tier 1 replies are constrained to two to four conversational sentences rather than monologues."}, {"id": "prompts_tier1_system_tier_1_metadata_contract", "label": "Tier 1 Metadata Contract", "file_type": "concept", "source_file": "rundale/prompts/tier1_system.txt", "source_location": "FORMAT and Example", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every spoken reply is followed by an exact separator and JSON object containing action, mood, internal thought, and language hints."}, {"id": "prompts_tier1_system_physical_action_metadata", "label": "Physical Action Metadata", "file_type": "concept", "source_file": "rundale/prompts/tier1_system.txt", "source_location": "FORMAT", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_tier1_system_post_reply_mood_metadata", "label": "Post-Reply Mood Metadata", "file_type": "concept", "source_file": "rundale/prompts/tier1_system.txt", "source_location": "FORMAT", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_tier1_system_internal_thought_metadata", "label": "Internal Thought Metadata", "file_type": "concept", "source_file": "rundale/prompts/tier1_system.txt", "source_location": "FORMAT", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prompts_tier1_system_language_hint_metadata", "label": "Language Hint Metadata", "file_type": "concept"