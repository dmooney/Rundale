{
  "inputSchema": {
    "$id": "rundale-dialogue-input-v2",
    "type": "object",
    "title": "Rundale Endpoint invocation v2",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "required": [
      "endpointContractVersion",
      "contractVersion",
      "sessionID",
      "logicalRequestID",
      "attemptID",
      "baseRevision",
      "idempotencyKey",
      "role",
      "playerInput",
      "speaker",
      "currentLocation",
      "knownPeople",
      "knownPlaces",
      "authoredFacts",
      "acquiredKnowledge",
      "rememberedPlayerClaims",
      "relevantTaskState",
      "recentConversation",
      "maxOutputChars",
      "maxStreamBytes"
    ],
    "properties": {
      "role": {
        "enum": ["npc_dialogue"],
        "type": "string"
      },
      "speaker": {
        "type": "object",
        "required": [
          "id",
          "displayName",
          "role",
          "currentLocationId",
          "currentLocationName"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "role": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "displayName": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "currentLocationId": {
            "type": "integer",
            "maximum": 4294967295,
            "minimum": 0
          },
          "currentLocationName": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "attemptID": {
        "type": "string",
        "maxLength": 200,
        "minLength": 1
      },
      "sessionID": {
        "type": "string",
        "maxLength": 200,
        "minLength": 1
      },
      "knownPeople": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "displayName",
            "role",
            "currentLocationId",
            "currentLocationName"
          ],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            },
            "role": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            },
            "displayName": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            },
            "currentLocationId": {
              "type": "integer",
              "maximum": 4294967295,
              "minimum": 0
            },
            "currentLocationName": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "maxItems": 32
      },
      "knownPlaces": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "displayName", "description", "playable"],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            },
            "playable": {
              "type": "boolean"
            },
            "description": {
              "type": "string",
              "maxLength": 4096,
              "minLength": 1
            },
            "displayName": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "maxItems": 32
      },
      "playerInput": {
        "type": "string",
        "maxLength": 4096,
        "minLength": 1
      },
      "baseRevision": {
        "type": "object",
        "required": ["rawValue"],
        "properties": {
          "rawValue": {
            "type": "integer",
            "maximum": 9007199254740991,
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "authoredFacts": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "statement", "source"],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            },
            "source": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            },
            "statement": {
              "type": "string",
              "maxLength": 4096,
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "maxItems": 32
      },
      "idempotencyKey": {
        "type": "string",
        "maxLength": 200,
        "minLength": 1
      },
      "maxOutputChars": {
        "enum": [8192],
        "type": "integer"
      },
      "maxStreamBytes": {
        "enum": [16384],
        "type": "integer"
      },
      "contractVersion": {
        "type": "object",
        "required": ["major", "minor"],
        "properties": {
          "major": {
            "enum": [1],
            "type": "integer"
          },
          "minor": {
            "enum": [0],
            "type": "integer"
          }
        },
        "additionalProperties": false
      },
      "currentLocation": {
        "type": "object",
        "required": ["id", "displayName", "description", "playable"],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "playable": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1
          },
          "displayName": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "logicalRequestID": {
        "type": "string",
        "maxLength": 200,
        "minLength": 1
      },
      "acquiredKnowledge": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "proposition", "knowingNpcID", "classification"],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 300,
              "minLength": 1
            },
            "proposition": {
              "type": "string",
              "maxLength": 512,
              "minLength": 1
            },
            "knowingNpcID": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            },
            "classification": {
              "enum": ["heard_from_npc"],
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "maxItems": 32
      },
      "relevantTaskState": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "authoredTemplateID", "status"],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 300,
              "minLength": 1
            },
            "status": {
              "enum": ["assigned", "in_progress", "completed"],
              "type": "string"
            },
            "authoredTemplateID": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "maxItems": 4
      },
      "recentConversation": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "timestamp",
            "location",
            "speaker_id",
            "speaker_name",
            "player_input",
            "npc_dialogue"
          ],
          "properties": {
            "location": {
              "type": "integer",
              "maximum": 4294967295,
              "minimum": 0
            },
            "timestamp": {
              "type": "string",
              "maxLength": 64,
              "minLength": 1
            },
            "speaker_id": {
              "type": "integer",
              "maximum": 4294967295,
              "minimum": 0
            },
            "npc_dialogue": {
              "type": "string",
              "maxLength": 8192,
              "minLength": 1
            },
            "player_input": {
              "type": "string",
              "maxLength": 4096,
              "minLength": 1
            },
            "speaker_name": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "maxItems": 8
      },
      "rememberedPlayerClaims": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "proposition", "knowingNpcID", "classification"],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 300,
              "minLength": 1
            },
            "proposition": {
              "type": "string",
              "maxLength": 512,
              "minLength": 1
            },
            "knowingNpcID": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            },
            "classification": {
              "enum": ["player_claim"],
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "maxItems": 32
      },
      "endpointContractVersion": {
        "enum": [2],
        "type": "integer"
      }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "$id": "rundale-dialogue-output-v2",
    "type": "object",
    "title": "Rundale NPC dialogue result v2",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "required": ["dialogue"],
    "properties": {
      "dialogue": {
        "type": "string",
        "maxLength": 8192,
        "minLength": 1
      },
      "authoredTaskOfferID": {
        "type": ["string", "null"],
        "maxLength": 200,
        "minLength": 1
      },
      "proposedPlayerMemory": {
        "type": ["object", "null"],
        "required": ["claim", "evidence"],
        "properties": {
          "claim": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "instructions": "You are the Rundale NPC dialogue Endpoint, immutable contract version 2. Produce one brief grounded utterance in the named speaker's voice, using only the supplied grounding. Authored facts, acquired knowledge, remembered player claims, and task state are separate bounded evidence sets; never promote a player claim or heard report to authored truth, and only recall knowledge supplied for this speaker. When Peig hears the exact player words ‘I grew up in Athleague.’, respond naturally and propose exactly one player memory with claim ‘The player grew up in Athleague.’ and evidence ‘I grew up in Athleague.’. When Peig is at the Letter Office and the player asks whether she has work, offer delivery of a sealed letter to Róisín and return authoredTaskOfferID ‘task-deliver-peig-letter’. If relevantTaskState shows that task completed, Peig may acknowledge its completion. Otherwise omit both optional effects. Memory evidence must be an exact substring of playerInput and you must never invent a task ID. All effects are provisional proposals and Rust alone validates and commits them. Return only schema-valid JSON, with no markdown or stage directions.",
  "providerConfig": {
    "model": "gemini-3.5-flash-lite",
    "provider": "google"
  },
  "inferenceConfig": {
    "streaming": {
      "version": 1,
      "textField": "dialogue"
    },
    "retryCount": 0,
    "maxOutputTokens": 1024
  }
}
