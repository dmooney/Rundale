{
	"name": "ui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"license": "GPL-3.0-only",
	"scripts": {
		"dev": "vite dev",
		"build": "node scripts/verify-notebook-person-art-freshness.mjs && vite build && node scripts/verify-map-glyph-assets.mjs dist/map-glyphs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node --test scripts/playwright-worktree-server.test.js",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:e2e": "playwright test",
		"test:e2e:contract": "playwright test --project ui-contract",
		"test:e2e:fullstack": "playwright test --project browser-fullstack",
		"test:e2e:update": "playwright test --update-snapshots",
		"notebook:art-candidates": "node scripts/generate-notebook-person-candidates.mjs",
		"notebook:art-candidates:test": "vitest run scripts/generate-notebook-person-candidates.test.mjs",
		"notebook:art-review": "node scripts/review-notebook-person-candidates.mjs",
		"notebook:art-review:test": "vitest run scripts/review-notebook-person-candidates.test.mjs",
		"notebook:art-promote": "node scripts/promote-notebook-person-art.mjs",
		"notebook:art-promote:test": "vitest run scripts/promote-notebook-person-art.test.mjs",
		"notebook:people": "node scripts/build-notebook-person-art.mjs",
		"notebook:people:test": "vitest run scripts/build-notebook-person-art.test.mjs",
		"notebook:art-pipeline:test": "vitest run scripts/generate-notebook-person-candidates.test.mjs scripts/review-notebook-person-candidates.test.mjs scripts/promote-notebook-person-art.test.mjs scripts/build-notebook-person-art.test.mjs scripts/notebook-person-art-promotion-build.integration.test.mjs",
		"test:playwright-launcher-integration": "node --test scripts/playwright-worktree-server.integration.test.js",
		"notices": "node ../../scripts/generate-ui-notices.mjs",
		"verify:map-glyphs": "node scripts/verify-map-glyph-assets.mjs",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^25.9.3",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"jsdom": "^29.1.1",
		"license-checker-rseidelsohn": "4.4.2",
		"pngjs": "^7.0.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.11.1",
		"html-to-image": "^1.11.13",
		"maplibre-gl": "^5.24.0",
		"phosphor-svelte": "^3.1.0"
	},
	"// overrides": "Force cookie>=0.7.0 transitive dep (GHSA-pxg6-pf52-xh8x / SvelteKit GHSA-7w22-3g77-7m57). Remove when @sveltejs/kit bumps its peer.",
	"overrides": {
		"cookie": "^0.7.0"
	}
}
