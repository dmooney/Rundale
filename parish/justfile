    eval "$(fnm env)" && cd apps/ui && npm run format

# Check frontend formatting without writing (CI gate)
ui-format-check:
    eval "$(fnm env)" && cd apps/ui && npm run format:check

# Run frontend component tests (vitest)
ui-test:
    eval "$(fnm env)" && cd apps/ui && npx vitest run

# Run Playwright UI-contract tests plus the real browser/parish-server lane.
# Keep the early ui-build feedback; the config-managed launcher rebuilds again
# immediately before capture so every Playwright entry point is safe (#1717).
ui-e2e: ui-build
    eval "$(fnm env)" && cd apps/ui && npx playwright test

# Update Playwright visual regression baselines
ui-e2e-update:
    cd apps/ui && npx playwright test --update-snapshots

# Regenerate GUI screenshots via Playwright (outputs to docs/screenshots/)
screenshots:
    cd apps/ui && npx playwright test e2e/screenshots.spec.ts

# ─── Inference benchmark ────────────────────────────────────────────────────

# Run /inf-bench against an OpenAI-compatible endpoint.
# Defaults target local Ollama with gemma4:e4b for both intent and main slots.
# Override via env: BASE_URL, INTENT_MODEL, MAIN_MODEL, ITERS, API_KEY.
inf-bench:
    cd {{justfile_directory()}} && \
        cargo run -p parish-inference --release --example inf_bench -- \
            --base-url "${BASE_URL:-http://localhost:11434}" \
            --intent-model "${INTENT_MODEL:-gemma4:e4b}" \
            --main-model  "${MAIN_MODEL:-gemma4:e4b}" \
            --iters "${ITERS:-3}" \
            $(if [ -n "${API_KEY:-}" ]; then echo "--api-key $API_KEY"; fi)

