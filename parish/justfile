    eval "$(fnm env)" && cd apps/ui && npm run check

# Lint the frontend (ESLint: typescript-eslint + eslint-plugin-svelte)
ui-lint:
    eval "$(fnm env)" && cd apps/ui && npm run lint

# Auto-format the frontend (Prettier, writes in place)
