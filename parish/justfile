# Parish — An Irish Living World Text Adventure
# Run `just` or `just --list` to see all available commands.

set shell := ["bash", "-euo", "pipefail", "-c"]

# Ensure cargo and fnm are on PATH for all recipes
export PATH := env("HOME") + "/.cargo/bin:" + env("HOME") + "/.local/share/fnm:" + env("PATH")

# Default: list available commands
default:
    @just --list

# ─── Setup ───────────────────────────────────────────────────────────────────

# One-time developer setup: install Rust, Node.js, tools, and frontend dependencies
setup:
    #!/usr/bin/env bash
    set -euo pipefail

    # Install system build dependencies (C compiler, linker, Tauri/WebView libs)
    if command -v dnf &>/dev/null; then
        echo "Installing system dependencies via dnf..."
        sudo dnf install -y gcc gcc-c++ make pkg-config \
            openssl-devel \
            gtk3-devel webkit2gtk4.1-devel libappindicator-gtk3-devel \
            librsvg2-devel patchelf
    elif command -v apt-get &>/dev/null; then
        echo "Installing system dependencies via apt..."
        sudo apt-get update
        sudo apt-get install -y build-essential pkg-config \
            libssl-dev \
            libgtk-3-dev libwebkit2gtk-4.1-dev libappindicator3-dev \
            librsvg2-dev patchelf
    else
        echo "WARNING: Unknown package manager. Ensure gcc, pkg-config, openssl-dev, and Tauri deps are installed."
    fi

    # Install Rust via rustup if missing
    if ! command -v cargo &>/dev/null; then
        echo "Installing Rust via rustup..."
        curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
        source "$HOME/.cargo/env"
        echo "Rust $(rustc --version) installed."
    else
        echo "Rust already installed: $(rustc --version)"
    fi

    # Install Node.js via fnm if missing
    if ! command -v node &>/dev/null; then
        echo "Installing fnm (Fast Node Manager)..."
        curl -fsSL https://fnm.vercel.app/install | bash -s -- --skip-shell
        export PATH="$HOME/.local/share/fnm:$PATH"
        eval "$(fnm env)"
        echo "Installing Node.js LTS..."
        fnm install --lts
        fnm use lts-latest
        echo "Node $(node --version) installed."
    else
        echo "Node.js already installed: $(node --version)"
    fi

    # Install Tauri CLI
    echo "Installing tauri-cli..."
    cargo install tauri-cli

    # Install Audit, Outdated, and Coverage tools
    echo "Installing cargo-audit, cargo-outdated and cargo-tarpaulin..."
    cargo install cargo-audit --locked
    cargo install cargo-outdated --locked
    cargo install cargo-tarpaulin --locked

    # Install frontend dependencies
    echo "Installing frontend dependencies..."
    cd apps/ui && npm install

    echo "Setup complete."

# Install frontend dependencies only
ui-install:
    eval "$(fnm env)" && cd apps/ui && npm install

# Install the language servers Claude Code uses for symbol navigation in the
# Svelte/TypeScript UI. Idempotent; safe to re-run. Restart the editor/agent
# session afterwards so the new binaries are picked up.
setup-lsp:
    npm install -g svelte-language-server typescript-language-server typescript

# ─── Build ───────────────────────────────────────────────────────────────────

# Build the workspace in debug mode
build:
    cargo build

# Build the workspace in release mode (optimized, LTO enabled)
build-release:
    cargo build --release

# Clean build artifacts
clean:
    cargo clean

# ─── Run ─────────────────────────────────────────────────────────────────────

# Run the game (Tauri desktop GUI) — syncs frontend deps with package-lock.json first.
# Auto-detects a free dev port so multiple instances can run simultaneously.
run:
    #!/usr/bin/env bash
    set -euo pipefail
    eval "$(fnm env)"
    (cd apps/ui && npm install --prefer-offline --no-audit --no-fund --loglevel error)
    PORT=5173
    while ss -tln 2>/dev/null | grep -q ":$PORT " || lsof -iTCP:$PORT -sTCP:LISTEN >/dev/null 2>&1; do
        PORT=$((PORT + 1))
        if [ "$PORT" -gt 5200 ]; then echo "No free port found in range 5173-5200" >&2; exit 1; fi
    done
    export PARISH_DEV_PORT=$PORT
    if [ "$PORT" -eq 5173 ]; then
        echo "Dev server port: $PORT"
        cargo tauri dev
    else
        echo "Dev server port: $PORT (default 5173 was in use)"
        cargo tauri dev --config "{\"build\":{\"devUrl\":\"http://localhost:$PORT\"}}"
    fi

# Run the game in LLM demo / auto-player mode (Tauri desktop GUI).
# Optional args: PAUSE=seconds between turns (default 2), MAX_TURNS=limit (default unlimited).
# Uses mods/rundale/demo-prompt.txt as the extra prompt.
# MCP bridge listens on $PARISH_MCP_PORT (default 3030) so `mcp__parish__*` tools work during the demo.
demo PAUSE="2" MAX_TURNS="":
    #!/usr/bin/env bash
    set -euo pipefail
    eval "$(fnm env)"
    (cd apps/ui && npm install --prefer-offline --no-audit --no-fund --loglevel error)
    PORT=5173
    while ss -tln 2>/dev/null | grep -q ":$PORT " || lsof -iTCP:$PORT -sTCP:LISTEN >/dev/null 2>&1; do
        PORT=$((PORT + 1))
        if [ "$PORT" -gt 5200 ]; then echo "No free port found in range 5173-5200" >&2; exit 1; fi
    done
    export PARISH_DEV_PORT=$PORT
    MCP_PORT="${PARISH_MCP_PORT:-3030}"
    PROMPT_FILE="{{justfile_directory()}}/../mods/rundale/demo-prompt.txt"
    DEMO_ARGS="--demo --demo-prompt $PROMPT_FILE --demo-pause {{PAUSE}} --mcp-port $MCP_PORT"
    if [ -n "{{MAX_TURNS}}" ]; then DEMO_ARGS="$DEMO_ARGS --demo-max-turns {{MAX_TURNS}}"; fi
    echo "Demo mode: pause={{PAUSE}}s, max_turns=${MAX_TURNS:-unlimited}, mcp_port=$MCP_PORT, prompt=$PROMPT_FILE"
    if [ "$PORT" -eq 5173 ]; then
        cargo tauri dev -- -- $DEMO_ARGS
    else
        cargo tauri dev --config "{\"build\":{\"devUrl\":\"http://localhost:$PORT\"}}" -- -- $DEMO_ARGS
    fi

# Profile inference request volume during a human-paced local-inference demo run.
demo-profile DURATION="300" PAUSE="10" MODEL="mlx-community/Qwen2.5-14B-Instruct-4bit" UPSTREAM="http://localhost:8000/v1":
    python3 scripts/profile-demo-requests.py --duration-secs {{DURATION}} --pause {{PAUSE}} --model {{MODEL}} --upstream {{UPSTREAM}}

# Run the game in headless REPL mode (plain stdin/stdout)
run-headless:
    cargo run -p parish-engine -- --headless

# Run the parish HTTP client (requires a running server; see `just web`)
run-client SERVER="http://localhost:3001":
    cargo run -p parish-client -- --server {{SERVER}}

# Run the axum web server (serves the Svelte UI in a browser)
#
# Always rebuilds the frontend first with a clean cache, because Vite's
# `.svelte-kit/` cache can hold stale compiled output after git operations
# (rebase/checkout/merge), making source edits appear invisible in the served
# UI and spuriously re-emitting already-fixed build warnings.
web PORT="3001": ui-build
    cargo run -p parish-server -- --port {{PORT}}

