---
import Base from '../layouts/Base.astro';
import Leaderboard from '../components/Leaderboard.svelte';
import ScatterPlot from '../components/ScatterPlot.svelte';
import { loadBenchData } from '../lib/data';
import { fmt, fmtMoneyHour, fmtValue } from '../lib/render';

const data = loadBenchData();
const base = import.meta.env.BASE_URL;
const merkleShort = data.merkle ? data.merkle.slice(0, 12) : '—';
const s = data.summary;

const cards = [
  { label: 'Top overall', row: s.overall, metric: (r: any) => `${fmt(r.overall)} / 5` },
  { label: 'Best value', row: s.value, metric: (r: any) => `${fmtValue(r.value_score)} value · ${fmtMoneyHour(r.usd_per_game_hour)}/hr` },
  { label: 'Best dialogue', row: s.dialogue, metric: (r: any) => `${fmt(r.categories?.dialogue?.score)} / 5` },
  { label: 'Fastest', row: s.fastest, metric: (r: any) => (r.latency_p50_ms != null ? `${r.latency_p50_ms} ms p50` : '—') },
].filter((c) => c.row);
---

<Base title="Rundale Bench v2 — LLM leaderboard">
  <section class="hero">
    <h1>Which model should run the Rundale world?</h1>
    <p class="sub">The benchmark of record for LLMs as the Rundale engine's NPC brain —
      scored on in-character dialogue, reaction, world simulation, intent, and
      Irish, then priced against real gameplay token volume.</p>
    <div class="provenance">
      <span class="prov-chip">judge <b>{data.judgeModel}</b></span>
      <span class="prov-chip">dataset <b><code>{merkleShort}</code></b></span>
      <span class="prov-chip"><b>{data.candidateCount}</b> candidate{data.candidateCount === 1 ? '' : 's'}</span>
      <span class="prov-chip">{data.generatedUtc ? `updated ${data.generatedUtc}` : 'no runs yet'}</span>
    </div>
  </section>

  {!data.hasRuns && (
    <div class="banner">
      <strong>Schema preview.</strong> The leaderboard is empty until the first
      funded promptfoo run is committed to
      <code>promptfoo/leaderboard/leaderboard.jsonl</code>. Provenance above is
      read from <code>config/judge.yaml</code> and <code>v2/MANIFEST.json</code>;
      the views below populate automatically once a run lands.
    </div>
  )}

  {data.hasRuns && (
    <>
      <div class="cards">
        {cards.map((c) => (
          <a class="card" href={`${base}/models/${c.row!.slug}`}>
            <div class="label">{c.label}</div>
            <div class="value">{c.row!.display_name}</div>
            <div class="metric">{c.metric(c.row)}</div>
          </a>
        ))}
      </div>

      <div class="panel">
        <div class="panel-head">
          <h2>Quality vs cost</h2>
          <span class="hint">models up-and-to-the-left win — high quality, low cost</span>
        </div>
        <ScatterPlot client:load rows={data.rows} base={base} />
      </div>
    </>
  )}

  <div class="panel">
    <div class="panel-head">
      <h2>Leaderboard</h2>
      <span class="hint">scores 1–5 · ±95% bootstrap CI · CI-aware rank</span>
    </div>
    <Leaderboard client:load rows={data.rows} categoryOrder={data.categoryOrder} base={base} />
  </div>
</Base>

<style>
  .hero { margin: 0.5rem 0 0.5rem; }
  .card { display: block; color: inherit; text-decoration: none; transition: border-color 0.1s ease, transform 0.1s ease; }
  .card:hover { border-color: var(--border-strong); text-decoration: none; transform: translateY(-1px); }
</style>
