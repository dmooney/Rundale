# rundale-bench v2 (promptfoo) task recipes.
#
# Run from repo root:
#     just -f promptfoo/justfile <recipe> [target-spec]
#
# `target` is a model@base_url[#env:VAR] spec (eval_lib.parse_target). Default
# is the local 7B MLX slot. Cloud keys + the judge key are sourced from ../.env.

ENV_FILE   := justfile_directory() / "../.env"
PF         := justfile_directory()
OUT        := PF / "output"
DEFAULT_TARGET := "mlx-community/Qwen2.5-7B-Instruct-4bit@http://localhost:8000/v1"

default:
    @just --justfile {{ justfile() }} --list

# Pin sha256 of the copied datasets.
manifest:
    python3 {{ PF }}/scripts/pin_manifest.py

# Python unit checks (no network).
test:
    python3 {{ PF }}/scripts/test_v2.py

_eval slice config target limit:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{ PF }}"
    [ -f "{{ ENV_FILE }}" ] && { set -a; source "{{ ENV_FILE }}"; set +a; } || true
    mkdir -p "{{ OUT }}"
    export RB_TARGET='{{ target }}'
    export RB_LIMIT='{{ limit }}'
    # RB_SLICE must be exported here, not left to each config's `env:` block:
    # promptfoo >=0.118 resolves the `tests: file://load_dataset.py` generator
    # during config load, BEFORE a config's `env:` is applied to the process,
    # so the loader sees no RB_SLICE and aborts with
    # "RB_SLICE env var required for load_dataset". Exporting it from the recipe
    # makes the documented `just … bench/<slice>` flow self-contained. (The perf
    # slice passes "perf"; nothing on the perf path reads RB_SLICE, so it's inert
    # there — generate_perf_tests loads dialogue records directly.)
    export RB_SLICE='{{ slice }}'
    # Two -o flags: JSON for scripts/report.py, HTML for a standalone web report.
    npx promptfoo eval -c "{{ config }}" \
        -o "{{ OUT }}/{{ slice }}.json" \
        -o "{{ OUT }}/{{ slice }}.html" \
        --no-cache

# Individual slices. `limit=""` runs the full slice.
dialogue  target=DEFAULT_TARGET limit="": (_eval "dialogue"  (PF / "promptfooconfig.dialogue.yaml")  target limit)
intent    target=DEFAULT_TARGET limit="": (_eval "intent"    (PF / "promptfooconfig.intent.yaml")    target limit)
reaction  target=DEFAULT_TARGET limit="": (_eval "reaction"  (PF / "promptfooconfig.reaction.yaml")  target limit)
tier2-sim target=DEFAULT_TARGET limit="": (_eval "tier2-sim" (PF / "promptfooconfig.tier2-sim.yaml") target limit)
tier3-sim target=DEFAULT_TARGET limit="": (_eval "tier3-sim" (PF / "promptfooconfig.tier3-sim.yaml") target limit)
gaeilge   target=DEFAULT_TARGET limit="": (_eval "gaeilge"   (PF / "promptfooconfig.gaeilge.yaml")   target limit)
multiturn target=DEFAULT_TARGET limit="": (_eval "multiturn" (PF / "promptfooconfig.multiturn.yaml") target limit)
perf      target=DEFAULT_TARGET limit="": (_eval "perf"      (PF / "promptfooconfig.perf.yaml")      target limit)

# Every quality slice + perf for one target, then the report.
bench target=DEFAULT_TARGET limit="": (dialogue target limit) (intent target limit) (reaction target limit) (tier2-sim target limit) (tier3-sim target limit) (gaeilge target limit) (multiturn target limit) (perf target limit) report

# --- REQ 1: enumerate every viable candidate across provider model lists ---
enumerate floor="8192":
    [ -f "{{ ENV_FILE }}" ] && { set -a; . "{{ ENV_FILE }}"; set +a; } || true; \
      python3 {{ PF }}/scripts/enumerate_candidates.py --context-floor {{ floor }}

# --- REQ 2: capture byte-exact runtime prompts → rebuild datasets ---
# Drives the real engine (simulator-free recording stub) over a scripted tour,
# then folds the captured requests into the v2 datasets. Re-pin the manifest after.
capture-prompts:
    bash {{ PF }}/scripts/capture_prompts.sh

# --- REQ 4: fold output/report.json into the append-only leaderboard ---
leaderboard tier="":
    python3 {{ PF }}/scripts/leaderboard.py {{ OUT }} {{ tier }}

# Roll up output/*.json → output/report.md + report.json.
report:
    python3 {{ PF }}/scripts/report.py {{ OUT }}

# Launch the promptfoo interactive web UI on the most recent eval(s).
# Per-test grid: each candidate × prompt, per-axis judge scores, latency, cost.
# Ctrl-C to stop. Optional port arg (default promptfoo's 15500).
view port="15500":
    cd "{{ PF }}" && npx promptfoo view -p {{ port }} --yes
