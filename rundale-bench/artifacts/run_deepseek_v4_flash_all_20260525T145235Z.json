      "results": [
        {
          "schema_valid": true,
          "in_character": 4,
          "length_ok": true,
          "non_latin_chars": {},
          "score": 0.8,
          "id": "reaction-0001",
          "reply": "Evenin' to ye. I'm Padraig Darcy, the publican."
        },
        {
          "schema_valid": true,
          "in_character": 4,
          "length_ok": true,
          "non_latin_chars": {},
          "score": 0.8,
          "id": "reaction-0002",
          "reply": "M\u00edche\u00e1l, you're a sight for sore eyes, though you've brought the damp with you. Step inside and warm yourself."
        },
        {
          "schema_valid": true,
          "in_character": 0,
          "length_ok": false,
          "non_latin_chars": {},
          "score": 0.0,
          "id": "reaction-0003",
          "reply": ""
        },
        {
          "schema_valid": true,
          "in_character": 5,
          "length_ok": true,
          "non_latin_chars": {},
          "score": 1.0,
          "id": "reaction-0004",
          "reply": "Good evenin' to ye. I'm Brigid O'Brien, the midwife of these parts\u2014welcome to Darcy's."
        },
        {
          "schema_valid": true,
          "in_character": 5,
          "length_ok": true,
          "non_latin_chars": {},
          "score": 1.0,
          "id": "reaction-0005",
          "reply": "\"Ah, M\u00e1ire, 'tis yourself. Ye're a sight for sore eyes on this wet morning.\""
        },
        {
          "schema_valid": true,
          "in_character": 5,
          "length_ok": true,
          "non_latin_chars": {},
          "score": 1.0,
          "id": "reaction-0006",
          "reply": "Nora Flynn, it's yourself. I trust you come bearing good news, and not a trouble?"
        },
        {
          "schema_valid": true,
          "in_character": 5,
          "length_ok": true,
          "non_latin_chars": {},
          "score": 1.0,
          "id": "reaction-0007",
          "reply": "I am Father Cathal Donnellan, the priest of this parish, and you are not of my congregation."
        },
        {
          "schema_valid": true,
          "in_character": 5,
          "length_ok": true,
          "non_latin_chars": {},
          "score": 1.0,
          "id": "reaction-0008",
          "reply": "P\u00e1draig. 'Tis a damp morning to be abroad, and at Brigid's cottage, of all places."
        },
        {
          "schema_valid": true,
          "in_character": 3,
          "length_ok": true,
          "non_latin_chars": {},
          "score": 0.6,
          "id": "reaction-0009",
          "reply": "Se\u00e1n, it is yourself. Come in from the mist, and leave all heathen notions at the door."
        },
        {
          "schema_valid": true,
          "in_character": 5,
          "length_ok": true,
          "non_latin_chars": {},
          "score": 1.0,
          "id": "reaction-0010",
          "reply": "Evenin'. I'm Sean Murphy, farmer from the bog."
        }
      ]
    },
