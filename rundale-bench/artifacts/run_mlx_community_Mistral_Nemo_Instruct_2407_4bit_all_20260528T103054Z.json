              "non_latin_detected": false,
              "refused": false
            }
          }
        },
        {
          "id": "reaction-0003",
          "reply": "\"Ah, Good day, Cormac. ye're just in time for a drop of the holy water.\"",
          "response_sha256": "f939c003f75ae562da865ea5130d4141b5c4d804f563b6ba7bf804e863ae660c",
          "cache_key": "3e4825ca44c0dbb09c26b9e2df3c5e4dde8eb44639658ec11d8135db07308d75",
          "judged": true,
          "judgment": {
            "axes": {
              "in_character": 2
            },
            "overall": 2.0,
            "flags": {
              "bench_bug": false,
