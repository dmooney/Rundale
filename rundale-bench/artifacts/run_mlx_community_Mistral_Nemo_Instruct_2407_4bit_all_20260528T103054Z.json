          "id": "reaction-0001",
          "reply": "Welcome, stranger. Padraig Darcy, proprietor of this establishment. What'll it be?",
          "response_sha256": "f95d46d8a7336e3711e77335786152f98e9f944c96b4190b597a693f2ff9a76e",
          "cache_key": "f58b3e2ac07106d9702df7fd5e5ec3a389c316627df146a9deb0297cd5e5fb6d",
          "judged": true,
          "judgment": {
