              "refused": false
            }
          }
        },
        {
          "id": "reaction-0007",
          "reply": "\"Welcome, stranger. I am Father Cathal, minister of these parts.\"",
          "response_sha256": "e2954b5530812d383f4af55da2ee66c25d32529680837c8326965e95a55b18a3",
          "cache_key": "c6a1886845390b7804e210c86b4df58c2da499667678bd5b1f0248b119a4a920",
