              "refused": false
            }
          }
        },
        {
          "id": "reaction-0004",
          "reply": "\"Welcome, stranger. I'm Brigid O'Brien, the midwife hereabouts. What brings ye to our humble tavern?\"",
          "response_sha256": "17362b0fd82eee2041fbc5fc9aa7296b9ae5aa01a0e66b9a44800422903c8648",
          "cache_key": "450b841b06b92f3dd966c8dbe9206b27450401da7c5fc73fca1343c1aa7cfcc1",
          "judged": true,
          "judgment": {
