              "refused": false
            }
          }
        },
        {
          "id": "reaction-0006",
          "reply": "\"Welcome, Siobhan. The mist suits you, like a shroud around your spirit.\"",
          "response_sha256": "a601c4f2f1887d375f589f15dace9372949e42713d9141b931c35c9bebd11d81",
          "cache_key": "45f37adab058eb23b88bb98565dcb1928820d8e0a074818b01b200a39f35f205",
          "judged": true,
