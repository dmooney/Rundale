              "non_latin_detected": false,
              "refused": false
            }
          }
        },
        {
          "id": "reaction-0002",
          "reply": "\"Morning, Eamon. Wet enough for ye out there, eh?\"",
          "response_sha256": "75d6627b51595697deab5f29910878c5ff4848e2507626bd931aec7d1f85745f",
          "cache_key": "471e01762d5ec61cf330daddf2e214e0894db70d58f2d0c3a1d160991bc1519e",
