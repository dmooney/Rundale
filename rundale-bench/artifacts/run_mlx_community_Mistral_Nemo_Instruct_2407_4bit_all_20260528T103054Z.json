              "non_latin_detected": false,
              "refused": false
            }
          }
        },
        {
          "id": "reaction-0005",
          "reply": "\"Ah, Good morn, Cormac! A wet one, indeed. What brings ye to my doorstep?\"",
          "response_sha256": "4015a8642a54e4a4ab954efea52941fbbf694ceeb3235fc4fb105a7226805ec1",
          "cache_key": "f8d8f47bda2c2b68bbf573d4311c12bdddb1f24e285517e29d794bb0102e5fa9",
          "judged": true,
          "judgment": {
