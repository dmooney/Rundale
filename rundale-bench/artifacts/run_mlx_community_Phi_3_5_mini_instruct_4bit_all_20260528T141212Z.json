      "results": [
        {
          "id": "reaction-0001",
          "reply": "\"Well met, stranger, pull up a stool and make yourself at home. This is Padraig's Pub, a dry enough place for a dry man like me. What can I get for you on this fine evening?\"",
          "response_sha256": "25454bc3e4780ef8998edc31a2e7451b43838c9be2b84a2a337b34e757cdbc52",
          "cache_key": "41d06f06fe1ffa18b6f8e029f3bf72456a94c8bd2cc62185508197d8084cd6cf",
