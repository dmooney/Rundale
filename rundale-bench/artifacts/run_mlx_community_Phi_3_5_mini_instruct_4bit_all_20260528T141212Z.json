        {
          "id": "reaction-0004",
          "reply": "\"Good evening, I am Brigid O'Brien, the local midwife, at your service.\"",
          "response_sha256": "2006c0b1ccbbc1cdb925969237029e29217ecf6919132d8c2c82b7e5ea1c1ee0",
          "cache_key": "a6dbade73a6edbf1f747fc4afbee8b406fde75c98d35aa54c28555f7b26a33b9",
          "judged": true,
          "judgment": {
