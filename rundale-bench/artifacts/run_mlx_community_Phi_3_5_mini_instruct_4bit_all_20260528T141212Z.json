            }
          }
        },
        {
          "id": "reaction-0006",
          "reply": "\"Bless me, Mary, for your presence warms our spirits on this blessed day, God bless you.\"",
          "response_sha256": "9c37891851e2e18ec22d64d41cdbaf91d699055dd48414251c3aefd2ac52b222",
          "cache_key": "2232ce74b353c23addf4e52e80acb91fb0d0c2d29c70ce5b7e2df46ab863c77c",
          "judged": true,
          "judgment": {
