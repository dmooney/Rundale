              "refused": false
            }
          }
        },
        {
          "id": "reaction-0008",
          "reply": "\"Greetings, Brother O'Malley, the rain blesses our Lord's earth this morn, but let it not dampen our spirits nor our devotion. Proceed with caution into Brigid's humble abode.\"",
          "response_sha256": "c843ae1e74a2115c926fe3e7a3c7dc3625aba53cde7f6ef408e54d41dedaafdf",
          "cache_key": "392e6284ebe49b0b281e3ee8c227c2ec0c32b599fa9bdd7c0a13b8463b380d3c",
          "judged": true,
          "judgment": {
