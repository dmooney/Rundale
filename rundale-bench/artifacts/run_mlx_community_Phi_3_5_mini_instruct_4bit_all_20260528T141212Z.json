            }
          }
        },
        {
          "id": "reaction-0007",
          "reply": "\"Good evening, stranger. I am Father Cathal Donnellan, servant of the Church, here to guide and counsel in these times of change and tribulation.\"",
          "response_sha256": "c3d6f711692dd70d369fdfecc702790953a5c00a6bc6be40d159128ad18da5e2",
          "cache_key": "eb967d479e1166624cb794c7f09c4d037258c7b80a2aa6b08cce5cc8f088ef2c",
          "judged": true,
          "judgment": {
