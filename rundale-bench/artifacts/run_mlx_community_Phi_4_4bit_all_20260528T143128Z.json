              "refused": false
            }
          }
        },
        {
          "id": "reaction-0005",
          "reply": "Ah, Seamus, 'tis good to see ye. Come in, come in; let us make ye dry and warm.",
          "response_sha256": "a89dba468ac4632cb160d1ed404953b5cc96191e9052da04e8e8427469124c22",
          "cache_key": "16dd4aac8e67bff1b5df90ca8c42f9cf6d1b14656f6730ac40e054d7dd5ede7e",
          "judged": true,
          "judgment": {
