        {
          "id": "reaction-0007",
          "reply": "Good evening, stranger. I am Father Cathal Donnellan, at your service. May your heart be open to the light of truth.",
          "response_sha256": "7e3c8998b046fb87a4b0b91e0ba64d30d05f86ada74a7d3d6cab7fad17fd8514",
          "cache_key": "d01d31fc3b0a29ee4b8ffcaabada3a7a6388a04fc11af842e3d9f73e42f67555",
          "judged": true,
