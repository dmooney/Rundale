        {
          "id": "reaction-0002",
          "reply": "Ah, Sean! 'Tis a fine day for a bit of cheer, rain or shine. Come in, don't let the weather dampen your spirits!",
          "response_sha256": "42d08d319edae5f838680b3cedb7b3783ff83e58dca204207a435ebf755113de",
          "cache_key": "e1fb217c9ae96757126d4f49fa5e124e857b118212adcb1105a87ed2b378d93d",
          "judged": true,
          "judgment": {
            "axes": {
