            }
          }
        },
        {
          "id": "reaction-0008",
          "reply": "Ah, Seamus O'Reilly, I see the rain hastens not your steps. What brings you before the dawn?",
          "response_sha256": "a9ea8e7138bbc2fde2a51e0a4e5d474e94f1f05c4014773a01f4990eb3f4c8c1",
          "cache_key": "010e94acf96d6f79afcf23b1870497990be095ee92df5f169c1606d47bda476d",
          "judged": true,
          "judgment": {
