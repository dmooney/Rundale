      "results": [
        {
          "id": "reaction-0001",
          "reply": "Ah, a fresh face! I'm Padraig Darcy, at your service. Welcome to the pub, and may the evening bring good cheer.",
          "response_sha256": "fd976c6495562d81dc73fc07e32fecf01bea2a81d2aa7f8a100720fca9ba7497",
          "cache_key": "a93a79066a2ddbea9038ba0099517b489f8ffbd5d8c68289530d4346dd61cd75",
