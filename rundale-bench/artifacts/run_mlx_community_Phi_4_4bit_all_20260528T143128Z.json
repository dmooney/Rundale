              "refused": false
            }
          }
        },
        {
          "id": "reaction-0003",
          "reply": "Ah, 'tis you, Seamus! Come in out of the chill. What news from the parish today?",
          "response_sha256": "ab11d9d64dc3c2e7735fe07cb87076f9bbd54b8be80d25aa8a83caee8a9fcedb",
          "cache_key": "1f9e111459b9f1e1daf9eb793f30058177b2b1f0aa76017cfac75482ac9b6957",
          "judged": true,
          "judgment": {
            "axes": {
              "in_character": 4
            },
            "overall": 4.0,
            "flags": {
              "bench_bug": false,
              "judge_retry": false,
              "non_latin_detected": false,
              "refused": false
            }
          }
        },
        {
          "id": "reaction-0004",
          "reply": "Good eve to ye. I am Brigid O'Brien, the midwife who tends to our folk hereabouts. May I be of service to ye or yours?",
          "response_sha256": "1b798afb7c9240159c793ad66c052383f14a341e383f74c1ecdd1f9baac10f20",
          "cache_key": "458c97c106e0bf5a934aa351833fde14811a31ad1b5e77930d9e031d10172380",
          "judged": true,
          "judgment": {
            "axes": {
              "in_character": 5
            },
            "overall": 5.0,
            "flags": {
              "bench_bug": false,
