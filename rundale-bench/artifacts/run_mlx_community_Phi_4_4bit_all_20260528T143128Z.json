              "non_latin_detected": false,
              "refused": false
            }
          }
        },
        {
          "id": "reaction-0006",
          "reply": "\"Ah, Caitr\u00edona, 'tis good to see ye. How may I be of help today?\"",
          "response_sha256": "8a693c6d3dff3aff7eace440e19658bc209864dbf06b82a44c3494c5f8b9617e",
          "cache_key": "bdddc4faedc4ea918420e24a937bfcd1b6bd05b95d0720410ed9c64c93454096",
