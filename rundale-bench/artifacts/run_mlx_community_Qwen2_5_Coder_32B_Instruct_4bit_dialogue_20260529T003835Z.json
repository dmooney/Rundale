              "refused": false
            }
          }
        },
        {
          "id": "dialogue-0005",
          "reply": "Ye'd best ask the right person hereabouts. I know naught of beasts takin' sheep. ---\n{\"action\": \"nods\", \"mood\": \"neutral\", \"internal_thought\": \"That's a matter for the farmer\", \"language_hints\": []}",
          "response_sha256": "bc2b08ab6e6e48b8c95200ac04a6e7ad89476faa60d7b8857737606053cca5e9",
          "cache_key": "fd56f776c140996316ab5a4260909a15951c5f397a3574ba27a86914d3c30d65",
          "judged": true,
          "judgment": {
