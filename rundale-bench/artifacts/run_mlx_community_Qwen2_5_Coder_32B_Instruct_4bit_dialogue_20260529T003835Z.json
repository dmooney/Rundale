              "non_latin_detected": false,
              "refused": false
            }
          }
        },
        {
          "id": "dialogue-0004",
          "reply": "Aye, heard talk of it. A new face among us. Mayhap he's come to see the sights or find work. ---\n{\"action\": \"nods\", \"mood\": \"curious\", \"internal_thought\": \"Wonder what brings him here\", \"language_hints\": []}",
          "response_sha256": "6a8c5cd308cb8b94b332f178d37db57011dfdc33f2c70c91925debdb4200f199",
          "cache_key": "4d2fa6dc4999cbabd94bc49dd66cf63e6055b0faa4ceb9d8bc6abd0841f7e4c6",
          "judged": true,
          "judgment": {
            "axes": {
              "authenticity": 2,
