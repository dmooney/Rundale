      },
      "results": [
        {
          "id": "reaction-0001",
          "reply": "Well, now, there ye are! I'm Padraig Darcy, this pub's keeper. What brings ye to these parts this fine evening?",
          "response_sha256": "5efdbb2679164f475132f76fbb3b3b301c7d8a517e9233f5d638d4fa040b7ee7",
          "cache_key": "055f12fbfbc6e3cb5cdb86d7386f60950e11d1c7bf16a99a2da844a1db9dfa76",
          "judged": true,
          "judgment": {
            "axes": {
              "in_character": 4
            },
            "overall": 4.0,
            "flags": {
              "bench_bug": false,
              "judge_retry": false,
              "non_latin_detected": false,
              "refused": false
            }
          }
        },
        {
          "id": "reaction-0002",
          "reply": "\"Ah, good morrow, Michael! Welcome back to Darcy's. I see the rain's gotten you, but 'twill be warm enough inside. Come, take a seat by the fire and tell me, what brings you to these parts this fine morn?\"",
          "response_sha256": "e5fc3b27e48a536b046f8c92d33329acff8398e2a281bcc2c355ca740439b083",
          "cache_key": "d0b2a33a13d6c5ceb774b30b842150b68138946ccb4e0b03da237d6d9b196f9d",
          "judged": true,
          "judgment": {
            "axes": {
              "in_character": 2
            },
            "overall": 2.0,
            "flags": {
              "bench_bug": false,
              "judge_retry": false,
              "non_latin_detected": false,
              "refused": false
            }
          }
        },
        {
          "id": "reaction-0003",
          "reply": "\"Ah, 'tis you, Michael! Welcome, welcome! Come in, come in and take a seat. 'Tis a fine day for a visit, isn't it?\"",
          "response_sha256": "9b8c5dff41d695438bcbcdc9b106629e01aa8ebecee3e8958dc29073476377a9",
          "cache_key": "0e369bcc020d4aac0e97bf5bb6abb810becd7ea013d9baab5c2f685fc677af5a",
          "judged": true,
          "judgment": {
            "axes": {
              "in_character": 2
            },
            "overall": 2.0,
            "flags": {
              "bench_bug": false,
              "judge_retry": false,
              "non_latin_detected": false,
              "refused": false
            }
          }
        },
        {
          "id": "reaction-0004",
          "reply": "\"Welcome, stranger. I'm Brigid, the midwife. May I help ye in some way? The night air can be chill, and I know these lands well. Perhaps ye've come seeking aid or a warm cup of tea.\"",
          "response_sha256": "e5753f0ee229b5841795244bf2ca52aa98bb838a0d123858758bf0dac0764647",
          "cache_key": "70dd5bbc2e49db342e886bd4eb6b99c63a684d2d2c3eac1347ff02ac970719c1",
          "judged": true,
          "judgment": {
            "axes": {
              "in_character": 4
            },
            "overall": 4.0,
            "flags": {
              "bench_bug": false,
              "judge_retry": false,
              "non_latin_detected": false,
              "refused": false
            }
          }
        },
        {
          "id": "reaction-0005",
          "reply": "\"Good morrow, Eamonn. Welcome to my cottage. What brings thee here this fine morning?\"",
          "response_sha256": "6be7bd4c6e796be375f5eb859217897a1b3f2e20da4756cd8026693734b82d82",
          "cache_key": "181f17467ef2ba92e0d22e4fc7c44934ea7c4f1db85536f1c6e811daa902774c",
          "judged": true,
          "judgment": {
            "axes": {
              "in_character": 4
            },
            "overall": 4.0,
            "flags": {
              "bench_bug": false,
              "judge_retry": false,
              "non_latin_detected": false,
              "refused": false
            }
          }
        },
        {
          "id": "reaction-0006",
          "reply": "\"Ah, welcome, Mary, back to the church again. I trust all is well? Come in, the warmth of the day invites us to stay a moment, does it not?\"",
          "response_sha256": "fc35df5e96ab70222a6079cd2b7e40100a920934db259ed1087df42a0fe9788f",
          "cache_key": "c671783a54708e3de1874cb982a25493406e20bc0969b9130c7d1bac0fb23f7c",
          "judged": true,
          "judgment": {
            "axes": {
              "in_character": 2
            },
            "overall": 2.0,
            "flags": {
              "bench_bug": false,
              "judge_retry": false,
              "non_latin_detected": false,
              "refused": false
            }
          }
        },
        {
          "id": "reaction-0007",
          "reply": "\"Welcome, stranger. I am the priest here, Father Cathal Donnellan. May this place bring you peace and comfort as you pass through our humble village.\"",
          "response_sha256": "4b5c04c5875dc54ef312f54c9dbd07a665f5f9037d5e75c59738fda33bd7388a",
          "cache_key": "13128b7abe4702516de10bb2c86eb5994c04ff878aecc93845483541a657f47a",
          "judged": true,
          "judgment": {
            "axes": {
              "in_character": 4
            },
            "overall": 4.0,
            "flags": {
              "bench_bug": false,
              "judge_retry": false,
              "non_latin_detected": false,
              "refused": false
            }
          }
        },
        {
          "id": "reaction-0008",
