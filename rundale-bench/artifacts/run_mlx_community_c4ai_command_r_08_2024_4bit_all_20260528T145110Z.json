      "results": [
        {
          "id": "reaction-0001",
          "reply": "Well, well, another face graces Darcy's threshold; a fine sight it is, too! 'Tis Padraig Darcy, publican of this here establishment, at your service.",
          "response_sha256": "6c113a8ebd5610ded62e4e93156c0e711db9c4b52e82c8eb0aa6ecb3bfd32240",
          "cache_key": "c5f51c890c6c85ff157313098122a47b103058ca9bbd7a022e572cc34976069f",
          "judged": true,
          "judgment": {
            "axes": {
              "in_character": 4
            },
            "overall": 4.0,
            "flags": {
              "bench_bug": false,
              "judge_retry": false,
              "non_latin_detected": false,
              "refused": false
            }
          }
        },
        {
          "id": "reaction-0002",
          "reply": "\"Ah, Brigid, me dear, it's a grand sight to see ye again. How's the world treatin' ye this mornin'?\"",
          "response_sha256": "9468091607db73a87faecbe817e1cbbc1aa2d24a1055818cc3b9d6b02e705058",
          "cache_key": "8185948c6e13c77076ed8ba3b9cf6ccdbdf80dc18f68f5515b15d26ceb031458",
          "judged": true,
          "judgment": {
            "axes": {
              "in_character": 3
            },
            "overall": 3.0,
            "flags": {
              "bench_bug": false,
              "judge_retry": false,
              "non_latin_detected": false,
              "refused": false
            }
          }
        },
        {
          "id": "reaction-0003",
          "reply": "Ah, good day, Father O'Malley. A fine, sunny Sunday we're havin', isn't it?",
          "response_sha256": "1ae704bde1ca9582b14e8502fb1a74370c9689da5f77cf12e7fa35e03f81810c",
          "cache_key": "16ff2b1c69be652a7aec70a343f68050983e0c6d2a306b0d1d466a2f6a9ababf",
          "judged": true,
          "judgment": {
            "axes": {
              "in_character": 2
            },
            "overall": 2.0,
            "flags": {
              "bench_bug": false,
              "judge_retry": false,
              "non_latin_detected": false,
              "refused": false
            }
          }
        },
        {
          "id": "reaction-0004",
          "reply": "Good evening, ma'am. I'm Brigid, the midwife hereabouts. I'm pleased to make your acquaintance.",
          "response_sha256": "e5e26a0b7cfa4425c947ba36334fcbaf00a9d09267ec89b3025dd1ac12aa99eb",
          "cache_key": "46bf80034685d929f93f02e7b9fd7149442faa893fac6a691d2df54a1bc4f013",
          "judged": true,
          "judgment": {
            "axes": {
              "in_character": 3
            },
            "overall": 3.0,
            "flags": {
              "bench_bug": false,
              "judge_retry": false,
              "non_latin_detected": false,
              "refused": false
            }
          }
        },
        {
          "id": "reaction-0005",
          "reply": "Good morrow, Michael. Welcome back to our little haven; I trust your journey was not too arduous?",
          "response_sha256": "4af193a5cbe86246ed8567338907015a9b563e1badb2af2ac2b00a319ed95c4e",
          "cache_key": "d8cc23ed64389ed96b0f7f376fd9e8d4482d6e9592ef288963c935ea3aa2e29c",
          "judged": true,
          "judgment": {
            "axes": {
              "in_character": 3
            },
            "overall": 3.0,
            "flags": {
              "bench_bug": false,
              "judge_retry": false,
              "non_latin_detected": false,
              "refused": false
            }
          }
        },
        {
          "id": "reaction-0006",
          "reply": "Ah, Michael, is it not? 'Tis a pleasure to see you again, my friend.",
          "response_sha256": "72f39ae6fea7fedd9f907c29a13f0bd8ea307074bee1b94f16f5388d344e0a01",
          "cache_key": "e82a3c3c419c4e450dc94300b3a77cdb44172e2aaf4602b992a0b79557fc19d1",
          "judged": true,
          "judgment": {
            "axes": {
              "in_character": 4
            },
            "overall": 4.0,
            "flags": {
              "bench_bug": false,
              "judge_retry": false,
              "non_latin_detected": false,
              "refused": false
            }
          }
        },
        {
          "id": "reaction-0007",
          "reply": "Good evening, sir. I am Father Cathal Donnellan, may I assist you with your spiritual needs?",
          "response_sha256": "6bfa5ae62ed6351563ff0124a9dc7a6d720eea5cdc7c99e9a9cb5efba5eaff93",
          "cache_key": "ce82c666a8a58de42227b349d5890109239533b7f27ba7130baec4790e7f3473",
          "judged": true,
          "judgment": {
            "axes": {
              "in_character": 3
            },
            "overall": 3.0,
            "flags": {
              "bench_bug": false,
              "judge_retry": false,
              "non_latin_detected": false,
              "refused": false
            }
          }
        },
        {
          "id": "reaction-0008",
          "reply": "Ah, Bridget, 'tis a pleasant surprise to see you again. May the morning's blessing guide your steps.",
          "response_sha256": "a809082380b34eb576faa4cb74306b35d0f3eb01466b327d3f381c54c6ded651",
          "cache_key": "4313015b074b5d841f62451c8466932cc60f797ca3ac6e90d1109b6d7a812360",
          "judged": true,
          "judgment": {
            "axes": {
              "in_character": 4
            },
            "overall": 4.0,
            "flags": {
              "bench_bug": false,
              "judge_retry": false,
              "non_latin_detected": false,
              "refused": false
            }
          }
        },
        {
          "id": "reaction-0009",
          "reply": "Ah, Mistress O'Connor, welcome once more to the house of the Lord.",
          "response_sha256": "00d02afdcfaea9a26408d79b0fddd82af234c5fcc0abe2ffc7d68137b01d1c5d",
          "cache_key": "cd555b3efea1ff6f787f58dfec4da6f9f3226f71195c44365a07d67c0601156a",
          "judged": true,
          "judgment": {
            "axes": {
