---
// Small brand glyph rendered to the left of a model name. Resolves a
// catalog family to a simple-icons SVG when available, otherwise a
// colored circle with deterministic initials. Caller controls layout
// (table cell, h2, link wrapper); this component only emits the glyph.
import { brandForFamily } from '../lib/brands';

interface Props {
  family?: string | null;
  // Pixel size of the glyph; default 16 matches the table-row line height.
  size?: number;
}
const { family, size = 16 } = Astro.props;
const brand = brandForFamily(family);
---
{brand?.kind === 'icon' && (
  <svg
    class="brand-icon"
    viewBox="0 0 24 24"
    width={size}
    height={size}
    role="img"
    aria-label={brand.title}
    style={`fill: #${brand.hex}`}
  >
    <title>{brand.title}</title>
    <path d={brand.svgPath} />
  </svg>
)}
{brand?.kind === 'fallback' && (
  <span
    class="brand-fallback"
    role="img"
    aria-label={brand.title}
    style={`width:${size}px;height:${size}px;background:#${brand.hex}`}
    title={brand.title}
  >{brand.initials}</span>
)}

<style is:global>
  .brand-icon, .brand-fallback {
    display: inline-block;
    vertical-align: -2px;
    margin-right: 0.4em;
    flex-shrink: 0;
  }
  .brand-fallback {
    color: #fff;
    border-radius: 999px;
    font-size: 0.62rem;
    font-weight: 600;
    line-height: 1;
    text-align: center;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    letter-spacing: 0.02em;
  }
</style>
