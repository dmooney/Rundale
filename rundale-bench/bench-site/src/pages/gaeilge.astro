---
import Base from '../layouts/Base.astro';
import SortableTable from '../components/SortableTable.svelte';
import data from '../data/bench.json';
import { modelCell, fmt, fmtPct } from '../lib/render';
const base = import.meta.env.BASE_URL;
const rows = data.gaeilge ?? [];
const AXES = ['fluency', 'grammar', 'idiom', 'task_fulfillment', 'english_leakage'];

const AXIS_ABBR = {
  fluency: 'Flu',
  grammar: 'Gram',
  idiom: 'Idiom',
  task_fulfillment: 'Task',
  english_leakage: 'Leak',
};
const columns = [
  { key: 'model_id', header: 'Model' },
  { key: 'overall', header: 'Overall', num: true },
  ...AXES.map((a) => ({ key: a, header: AXIS_ABBR[a] ?? a, num: true })),
  { key: 'english_leakage_flag_rate', header: 'Leak %', num: true },
  { key: 'records', header: 'n', num: true },
];

const tableRows = rows.map((r) => ({
  sort: {
    model_id: r.model_id,
    overall: r.overall,
    ...Object.fromEntries(AXES.map((a) => [a, r[a]])),
    english_leakage_flag_rate: r.english_leakage_flag_rate ?? 0,
    records: r.records,
  },
  html: {
    model_id: modelCell(r, base),
    overall: `<strong>${fmt(r.overall)}</strong>`,
    ...Object.fromEntries(AXES.map((a) => [a, fmt(r[a])])),
    english_leakage_flag_rate: fmtPct(r.english_leakage_flag_rate ?? 0),
    records: typeof r.records === 'number' ? String(r.records) : '—',
  },
}));
---
<Base title="Rundale Bench — Gaeilge fluency">
  <h2>Irish (Gaeilge) fluency</h2>
  <p class="muted">
    Eleven prompts test natural Irish syntax, idiom, and task-fulfilment. Axes
    are 1–5 means. <strong>english_leakage</strong> is scored 5 = stayed in
    Irish, 1 = fell back to English. NPC dialogue in Rundale code-switches
    en-IE / ga-IE, so a model with strong dialogue scores can still fail here.
  </p>
  <p class="muted">
    Judged by <span class="badge">⚖ judge_gaeilge_v1 (claude-sonnet-4-6)</span>.
    Rubric: knows Standard Irish + Connacht dialect; rejects English
    explanations, Scots Gaelic, Welsh, or pseudo-Irish word-strings; tolerates
    dialect variation, missing fadas, and proper names.
  </p>
  {rows.length === 0 ? (
    <div class="empty">No gaeilge runs yet. Run the gaeilge slice and ingest.</div>
  ) : (
    <SortableTable client:load columns={columns} rows={tableRows} initialSort={{ key: 'overall', dir: -1 }} />
  )}
</Base>
