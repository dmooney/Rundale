---
import Base from '../../layouts/Base.astro';
import BrandIcon from '../../components/BrandIcon.astro';
import SortableTable from '../../components/SortableTable.svelte';
import SamplesBrowser from '../../components/SamplesBrowser.svelte';
import data from '../../data/bench.json';
import { badge, fmt, fmtInt, fmtMoney, fmtMoneyHour, fmtPct } from '../../lib/render';
const base = import.meta.env.BASE_URL;

export function getStaticPaths() {
  // One page per observed model — drives links from /perf and /models so
  // they never 404. Union of every data source (leaderboard, gaeilge,
  // samples, perf, models_index).
  const slugs = new Map();
  for (const row of data.models_index ?? []) slugs.set(row.slug, { model_id: row.model_id, display_name: row.display_name, is_local: row.is_local, family: row.family });
  for (const row of data.leaderboard ?? []) {
    const e = slugs.get(row.slug) ?? { model_id: row.model_id };
    e.dialogue = row;
    e.family = e.family ?? row.family;
    e.display_name = e.display_name ?? row.display_name;
    slugs.set(row.slug, e);
  }
  for (const row of data.gaeilge ?? []) {
    const e = slugs.get(row.slug) ?? { model_id: row.model_id };
    e.gaeilge_row = row;
    e.family = e.family ?? row.family;
    e.display_name = e.display_name ?? row.display_name;
    slugs.set(row.slug, e);
  }
  for (const [slug, s] of Object.entries(data.samples ?? {})) {
    const e = slugs.get(slug) ?? { model_id: s.model_id };
    slugs.set(slug, e);
  }
  for (const row of data.perf ?? []) {
    if (!slugs.has(row.slug)) slugs.set(row.slug, { model_id: row.model_id, display_name: row.display_name, is_local: row.is_local, family: row.family });
  }
  return [...slugs.entries()].map(([slug, view]) => ({ params: { slug }, props: { slug, view } }));
}

const { slug, view } = Astro.props;
const samples = (data.samples ?? {})[slug] ?? {};
const dialogueRow = view.dialogue;
const gaeilgeRow = view.gaeilge_row;
const perf = (data.perf ?? []).filter((p) => p.model_id === view.model_id);
const typeBadge = view.is_local ? 'local' : 'cloud';
const DIALOGUE_AXES = ['character', 'authenticity', 'language', 'responsiveness', 'craft'];
const GAEILGE_AXES = ['fluency', 'grammar', 'idiom', 'task_fulfillment', 'english_leakage'];

// Header summary stats — best-of across perf providers + the two quality
// signals + the bench-bug count surfaced from the dialogue summary.
const bestGameHr = perf.reduce((best, p) => {
  const v = p.gameplay_cost_usd_per_hour;
  return typeof v === 'number' && (best === null || v < best) ? v : best;
}, null);
const bestP50 = perf.reduce((best, p) => {
  const v = p.latency_p50_ms;
  return typeof v === 'number' && (best === null || v < best) ? v : best;
}, null);
const bestTokS = perf.reduce((best, p) => {
  const v = p.tokens_per_sec_mean;
  return typeof v === 'number' && (best === null || v > best) ? v : best;
}, null);
const bestUsdPerMtok = perf.reduce((best, p) => {
  const v = p.usd_per_mtok_observed;
  return typeof v === 'number' && (best === null || v < best) ? v : best;
}, null);

const perfColumns = [
  { key: 'provider_id', header: 'Provider' },
  { key: 'latency_p50_ms', header: 'p50 ms', num: true },
  { key: 'latency_p95_ms', header: 'p95/p90 ms', num: true },
  { key: 'tokens_per_sec_mean', header: 'tok/s', num: true },
  { key: 'ttft_p50_ms', header: 'ttft p50 ms', num: true },
  { key: 'usd_per_mtok_observed', header: '$/Mtok', num: true },
  { key: 'gameplay_cost_usd_per_minute', header: 'game $/min', num: true },
  { key: 'gameplay_cost_usd_per_hour', header: 'game $/hr', num: true },
  { key: 'error_rate', header: 'err', num: true },
  { key: 'source', header: 'source' },
];

const perfRows = perf.map((r) => ({
  sort: {
    provider_id: r.provider_id,
    latency_p50_ms: r.latency_p50_ms,
    latency_p95_ms: r.latency_p95_ms,
    tokens_per_sec_mean: r.tokens_per_sec_mean,
    ttft_p50_ms: r.ttft_p50_ms,
    usd_per_mtok_observed: r.usd_per_mtok_observed,
    gameplay_cost_usd_per_minute: r.gameplay_cost_usd_per_minute,
    gameplay_cost_usd_per_hour: r.gameplay_cost_usd_per_hour,
    error_rate: r.error_rate ?? 0,
    source: r.source ?? 'phase3',
  },
  html: {
    provider_id: badge(r.provider_id),
    latency_p50_ms: fmtInt(r.latency_p50_ms),
    latency_p95_ms: fmtInt(r.latency_p95_ms),
    tokens_per_sec_mean: fmt(r.tokens_per_sec_mean, 1),
    ttft_p50_ms: fmtInt(r.ttft_p50_ms),
    usd_per_mtok_observed: r.usd_per_mtok_observed != null ? `$${r.usd_per_mtok_observed}` : '—',
    gameplay_cost_usd_per_minute: fmtMoney(r.gameplay_cost_usd_per_minute),
    gameplay_cost_usd_per_hour: fmtMoneyHour(r.gameplay_cost_usd_per_hour),
    error_rate: fmtPct(r.error_rate ?? 0, 0),
    source: badge(r.source ?? 'phase3'),
  },
}));
---
<Base title={`Rundale Bench — ${view.display_name ?? view.model_id}`}>
  <p><a href={`${base}/models`}>← all models</a> · <a href={base}>leaderboard</a></p>
  <h2><BrandIcon family={view.family} size={28} />{view.display_name ?? view.model_id} <span class="badge" title={view.is_local ? 'local runtime' : 'cloud-hosted'}>{typeBadge}</span></h2>
  {view.display_name && view.display_name !== view.model_id && (
    <p class="muted" style="margin-top:-0.5em;font-family:monospace;font-size:0.85em">{view.model_id}</p>
  )}

  <div class="stat-grid">
    <div class="stat">
      <div class="stat-label">Dialogue overall</div>
      <div class="stat-value">{fmt(dialogueRow?.overall)}</div>
      <div class="stat-sub">{dialogueRow ? `${dialogueRow.judged}/${dialogueRow.records} judged` : 'no runs yet'}{dialogueRow?.bench_bugs ? ` · 🐛 ${dialogueRow.bench_bugs} bug${dialogueRow.bench_bugs === 1 ? '' : 's'}` : ''}</div>
    </div>
    <div class="stat">
      <div class="stat-label">Gaeilge overall</div>
      <div class="stat-value">{fmt(gaeilgeRow?.overall)}</div>
      <div class="stat-sub">{gaeilgeRow ? `${gaeilgeRow.records} prompt(s)` : 'no runs yet'}</div>
    </div>
    <div class="stat">
      <div class="stat-label">Best gameplay $/hr</div>
      <div class="stat-value">{fmtMoneyHour(bestGameHr)}</div>
      <div class="stat-sub">{bestUsdPerMtok != null ? `$${bestUsdPerMtok}/Mtok observed` : 'no perf cost data'}</div>
    </div>
    <div class="stat">
      <div class="stat-label">Best p50 latency</div>
      <div class="stat-value">{bestP50 != null ? `${Math.round(bestP50)} ms` : '—'}</div>
      <div class="stat-sub">{bestTokS != null ? `top ${bestTokS.toFixed(1)} tok/s` : 'no perf data'}</div>
    </div>
  </div>

  {!dialogueRow && !gaeilgeRow && (
    <p class="muted">No quality runs yet — only perf data below.</p>
  )}

  {dialogueRow && (
    <>
      <h3>Dialogue</h3>
      <p class="muted">
        family {dialogueRow.family} · tier {dialogueRow.tier ?? 'n/a'} ·
        judged by <span class="badge">⚖ {dialogueRow.judge_id}</span>
        · {dialogueRow.judged ?? '—'} prompt(s)
        {dialogueRow.non_latin_rate ? ` · non-Latin rate ${(dialogueRow.non_latin_rate * 100).toFixed(1)}%` : ''}
      </p>
      <table>
        <thead><tr><th>Axis</th><th class="num">Score</th></tr></thead>
        <tbody>
          <tr><td><strong>Overall</strong></td><td class="num"><strong>{dialogueRow.pending_judge ? '(pending judge)' : fmt(dialogueRow.overall)}</strong></td></tr>
          {DIALOGUE_AXES.map((ax) => (
            <tr><td>{ax}</td><td class="num">{fmt(dialogueRow[ax])}</td></tr>
          ))}
          {(() => {
            const records = dialogueRow.records ?? 0;
            const bugs = dialogueRow.bench_bugs ?? 0;
            const rate = records > 0 ? `${bugs}/${records} (${(bugs / records * 100).toFixed(0)}%)` : '—';
            return <tr><td>bench-bug rate</td><td class="num" title="responses flagged as chain-of-thought bypass or harness bug, excluded from the score">{rate}</td></tr>;
          })()}
        </tbody>
      </table>
      {samples.dialogue?.items?.length > 0 && (
        <>
          <h4>Dialogue prompts &amp; responses</h4>
          <p class="muted">All {samples.dialogue.items.length} judged prompt(s) with per-axis scores.</p>
          <SamplesBrowser client:load items={samples.dialogue.items} axes={samples.dialogue.axes} />
        </>
      )}
    </>
  )}

  {gaeilgeRow && (
    <>
      <h3 style="margin-top:2rem">Gaeilge fluency</h3>
      <p class="muted">
        judged by <span class="badge">⚖ {samples.gaeilge?.judge_id ?? 'gaeilge_fluency_judge_v1'}</span>
        ({samples.gaeilge?.judge_model ?? 'claude-sonnet-4-6'}) ·
        {gaeilgeRow.records ?? '—'} prompt(s) · english-leakage flag rate
        {((gaeilgeRow.english_leakage_flag_rate ?? 0) * 100).toFixed(1)}%
      </p>
      <table>
        <thead><tr><th>Axis</th><th class="num">Score</th></tr></thead>
        <tbody>
          <tr><td><strong>Overall</strong></td><td class="num"><strong>{fmt(gaeilgeRow.overall)}</strong></td></tr>
          {GAEILGE_AXES.map((ax) => (
            <tr><td>{ax}</td><td class="num">{fmt(gaeilgeRow[ax])}</td></tr>
          ))}
        </tbody>
      </table>
      {samples.gaeilge?.items?.length > 0 && (
        <>
          <h4>Gaeilge prompts &amp; responses</h4>
          <p class="muted">All {samples.gaeilge.items.length} judged prompt(s) with per-axis scores and the judge's reason.</p>
          <SamplesBrowser client:load items={samples.gaeilge.items} axes={samples.gaeilge.axes} />
        </>
      )}
    </>
  )}

  <h3 style="margin-top:2rem">Perf by provider</h3>
  {perf.length === 0 ? (
    <div class="empty">No perf measured for this model yet.</div>
  ) : (
    <SortableTable client:load columns={perfColumns} rows={perfRows} initialSort={{ key: 'latency_p50_ms', dir: 1 }} />
  )}
</Base>

<style is:global>
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 0.75rem;
    margin: 1rem 0 2rem;
  }
  .stat {
    border: 1px solid var(--gray-200, #e5e7eb);
    border-radius: 6px;
    padding: 0.75rem 1rem;
    background: var(--gray-50, #f9fafb);
  }
  .stat-label { font-size: 0.78rem; color: var(--gray-500, #6b7280); text-transform: uppercase; letter-spacing: 0.04em; }
  .stat-value { font-size: 1.6rem; font-weight: 700; margin-top: 0.2rem; }
  .stat-sub { font-size: 0.8rem; color: var(--gray-500, #6b7280); margin-top: 0.15rem; }
</style>
