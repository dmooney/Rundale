---
import Base from '../../layouts/Base.astro';
import SortableTable from '../../components/SortableTable.svelte';
import data from '../../data/bench.json';
import { modelCell, badge, fmt, fmtInt, fmtMoney, fmtMoneyHour } from '../../lib/render';
const base = import.meta.env.BASE_URL;
const rows = data.models_index ?? [];

const columns = [
  { key: 'model_id', header: 'Model' },
  { key: 'is_local', header: 'Type' },
  { key: 'dialogue_overall', header: 'Dialog', num: true },
  { key: 'gaeilge_overall', header: 'Gaeilge', num: true },
  { key: 'perf_best_p50_ms', header: 'p50 ms', num: true },
  { key: 'perf_mean_tok_s', header: 'tok/s', num: true },
  { key: 'perf_best_gameplay_usd_per_hour', header: '$/hr', num: true },
  { key: 'perf_providers', header: 'Provs', num: true },
];

const tableRows = rows.map((r) => ({
  sort: {
    model_id: r.model_id,
    is_local: r.is_local ? 'local' : 'cloud',
    dialogue_overall: r.dialogue_overall,
    gaeilge_overall: r.gaeilge_overall,
    perf_best_p50_ms: r.perf_best_p50_ms,
    perf_mean_tok_s: r.perf_mean_tok_s,
    perf_best_gameplay_usd_per_hour: r.perf_best_gameplay_usd_per_hour,
    perf_providers: r.perf_providers?.length ?? 0,
  },
  html: {
    model_id: modelCell(r, base),
    is_local: badge(r.is_local ? 'local' : 'cloud',
                    r.is_local ? 'local runtime (MLX/Ollama/etc.)' : 'cloud-hosted'),
    dialogue_overall: fmt(r.dialogue_overall),
    gaeilge_overall: fmt(r.gaeilge_overall),
    perf_best_p50_ms: fmtInt(r.perf_best_p50_ms),
    perf_mean_tok_s: fmt(r.perf_mean_tok_s, 1),
    perf_best_gameplay_usd_per_hour: fmtMoneyHour(r.perf_best_gameplay_usd_per_hour),
    perf_providers: r.perf_providers?.length ? String(r.perf_providers.length) : '—',
  },
}));
---
<Base title="Rundale Bench — Models">
  <h2>All models</h2>
  <p class="muted">
    Every model that has been seen by the bench, with whichever signals are
    present. <strong>—</strong> means not yet measured for that column. Click a
    column header to sort; click a row to drill into per-prompt samples +
    per-provider perf.
  </p>
  <SortableTable client:load columns={columns} rows={tableRows} initialSort={{ key: 'dialogue_overall', dir: -1 }} />
  <p class="muted">
    Quality rows ranked by dialogue overall by default. Missing dialogue +
    gaeilge ⇒ model has only perf data so far — run the funnel against it to
    fill the quality columns.
  </p>
</Base>
