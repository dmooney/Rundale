---
import Base from '../layouts/Base.astro';
import data from '../data/bench.json';
const base = import.meta.env.BASE_URL;
const perf = data.perf ?? [];
const profile = data.normal_play_profile;
const profileCategories = Object.values(profile?.categories ?? {}).filter((c) => c.included_in_gameplay_cost);
const profileRows = [
  ...profileCategories.map((c) => ({ ...c, label: c.category, isTotal: false })),
  ...(profile ? [{ ...profile.total_gameplay, label: 'Total gameplay', isTotal: true }] : []),
];
const costExamples = data.cloud_cost_examples ?? [];
const fmt = (v, d = 0) => (typeof v === 'number' ? v.toFixed(d) : '—');
const fmtMoney = (v, d = 4) => (typeof v === 'number' ? `$${v.toFixed(d)}` : '—');
const fmtMoneyHour = (v) => (typeof v === 'number' ? `$${v.toFixed(2)}` : '—');
// Every perf row's model gets a /models/<slug> page via models_index, so
// linking is unconditional now.
---
<Base title="Rundale Bench — Perf matrix">
  <h2>Per-provider performance</h2>
  <p class="muted">
    Latency, throughput, price, and reliability per (model, provider). Quality
    is judged once on the cheapest provider — perf is measured independently
    so the leaderboard isn't biased by speed or price. <span class="badge">legacy</span>
    rows come from earlier OpenRouter sweeps (TTFT + total ms);
    <span class="badge">phase3</span> rows are the new harness (full latency + observed $/Mtok).
  </p>
  {profile && (
    <>
      <h3>Normal-play cost profile</h3>
      <p class="muted">
        Cost estimates use {fmt(profile.total_gameplay?.requests_per_minute, 2)} gameplay request(s)/minute,
        about {fmt(profile.total_gameplay?.input_tokens_per_minute_estimated)} input token(s)/minute and
        {fmt(profile.total_gameplay?.output_tokens_per_minute_estimated)} output token(s)/minute.
        The synthetic demo-player category is excluded. Source: <code>{profile.source}</code>.
      </p>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>Category</th><th class="num">req/min</th>
              <th class="num">input tok/req</th><th class="num">output tok/req</th>
              <th class="num">input tok/min</th><th class="num">output tok/min</th>
            </tr>
          </thead>
          <tbody>
            {profileRows.map((c) => (
              <tr>
                <td>{c.isTotal ? <strong>{c.label}</strong> : c.label}</td>
                <td class="num">{c.isTotal ? <strong>{fmt(c.requests_per_minute, 2)}</strong> : fmt(c.requests_per_minute, 2)}</td>
                <td class="num">{c.isTotal ? <strong>{fmt(c.input_tokens_per_request_estimated)}</strong> : fmt(c.input_tokens_per_request_estimated)}</td>
                <td class="num">{c.isTotal ? <strong>{fmt(c.output_tokens_per_request_estimated)}</strong> : fmt(c.output_tokens_per_request_estimated)}</td>
                <td class="num">{c.isTotal ? <strong>{fmt(c.input_tokens_per_minute_estimated)}</strong> : fmt(c.input_tokens_per_minute_estimated)}</td>
                <td class="num">{c.isTotal ? <strong>{fmt(c.output_tokens_per_minute_estimated)}</strong> : fmt(c.output_tokens_per_minute_estimated)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}
  {costExamples.length > 0 && (
    <>
      <h3>Catalog cloud cost examples</h3>
      <p class="muted">
        Examples combine the same normal-play profile with input/output prices from
        <code>rundale-bench/v1/models.toml</code>. Prices are point-in-time estimates; verify provider pricing before spending money.
      </p>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>Model</th><th>Provider</th>
              <th class="num">input $/M</th><th class="num">output $/M</th>
              <th class="num">game $/min</th><th class="num">game $/hr</th>
            </tr>
          </thead>
          <tbody>
            {costExamples.map((r) => (
              <tr>
                <td>{r.display_name ?? r.model_id}</td>
                <td><span class="badge">{r.provider_id}</span></td>
                <td class="num">{fmtMoney(r.price_input_usd_per_mtok, 2)}</td>
                <td class="num">{fmtMoney(r.price_output_usd_per_mtok, 2)}</td>
                <td class="num">{fmtMoney(r.gameplay_cost_usd_per_minute)}</td>
                <td class="num">{fmtMoneyHour(r.gameplay_cost_usd_per_hour)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}
  {perf.length === 0 ? (
    <div class="empty">No perf measurements yet.</div>
  ) : (
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>Model</th><th>Provider</th>
            <th class="num">total p50 ms</th><th class="num">total p95/p90 ms</th>
            <th class="num">tok/s</th><th class="num">ttft p50 ms</th>
            <th class="num">$/Mtok</th><th class="num">game $/min</th><th class="num">game $/hr</th>
            <th class="num">err</th><th>source</th>
          </tr>
        </thead>
        <tbody>
          {perf.map((r) => (
            <tr>
              <td><a href={`${base}/models/${r.slug}`}>{r.model_id}</a>
                {r.is_local && <span class="badge" title="local runtime">local</span>}</td>
              <td><span class="badge">{r.provider_id}</span></td>
              <td class="num">{fmt(r.latency_p50_ms)}</td>
              <td class="num">{fmt(r.latency_p95_ms)}</td>
              <td class="num">{fmt(r.tokens_per_sec_mean, 1)}</td>
              <td class="num">{fmt(r.ttft_p50_ms)}</td>
              <td class="num">{r.usd_per_mtok_observed != null ? `$${r.usd_per_mtok_observed}` : '—'}</td>
              <td class="num">{fmtMoney(r.gameplay_cost_usd_per_minute)}</td>
              <td class="num">{fmtMoneyHour(r.gameplay_cost_usd_per_hour)}</td>
              <td class="num">{fmt((r.error_rate ?? 0) * 100)}%</td>
              <td><span class="badge">{r.source ?? 'phase3'}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</Base>
