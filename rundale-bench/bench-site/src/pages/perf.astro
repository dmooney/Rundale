---
import Base from '../layouts/Base.astro';
import SortableTable from '../components/SortableTable.svelte';
import data from '../data/bench.json';
import { modelCell, badge, fmt, fmtInt, fmtMoney, fmtMoneyHour, fmtPct } from '../lib/render';
const base = import.meta.env.BASE_URL;
const perf = data.perf ?? [];
const profile = data.normal_play_profile;
const profileCategories = Object.values(profile?.categories ?? {}).filter((c) => c.included_in_gameplay_cost);
const profileRows = [
  ...profileCategories.map((c) => ({ ...c, label: c.category, isTotal: false })),
  ...(profile ? [{ ...profile.total_gameplay, label: 'Total gameplay', isTotal: true }] : []),
];
const costExamples = data.cloud_cost_examples ?? [];

const costColumns = [
  { key: 'model_id', header: 'Model' },
  { key: 'provider_id', header: 'Provider' },
  { key: 'price_input_usd_per_mtok', header: 'input $/M', num: true },
  { key: 'price_output_usd_per_mtok', header: 'output $/M', num: true },
  { key: 'gameplay_cost_usd_per_minute', header: 'game $/min', num: true },
  { key: 'gameplay_cost_usd_per_hour', header: 'game $/hr', num: true },
];

const costRows = costExamples.map((r) => ({
  sort: {
    model_id: r.display_name ?? r.model_id,
    provider_id: r.provider_id,
    price_input_usd_per_mtok: r.price_input_usd_per_mtok,
    price_output_usd_per_mtok: r.price_output_usd_per_mtok,
    gameplay_cost_usd_per_minute: r.gameplay_cost_usd_per_minute,
    gameplay_cost_usd_per_hour: r.gameplay_cost_usd_per_hour,
  },
  html: {
    model_id: modelCell({ model_id: r.model_id, family: r.family, display_name: r.display_name, slug: r.slug ?? null }, base),
    provider_id: badge(r.provider_id),
    price_input_usd_per_mtok: fmtMoney(r.price_input_usd_per_mtok, 2),
    price_output_usd_per_mtok: fmtMoney(r.price_output_usd_per_mtok, 2),
    gameplay_cost_usd_per_minute: fmtMoney(r.gameplay_cost_usd_per_minute),
    gameplay_cost_usd_per_hour: fmtMoneyHour(r.gameplay_cost_usd_per_hour),
  },
}));

const perfColumns = [
  { key: 'model_id', header: 'Model' },
  { key: 'provider_id', header: 'Provider' },
  { key: 'latency_p50_ms', header: 'total p50 ms', num: true },
  { key: 'latency_p95_ms', header: 'total p95/p90 ms', num: true },
  { key: 'tokens_per_sec_mean', header: 'tok/s', num: true },
  { key: 'ttft_p50_ms', header: 'ttft p50 ms', num: true },
  { key: 'usd_per_mtok_observed', header: '$/Mtok', num: true },
  { key: 'gameplay_cost_usd_per_minute', header: 'game $/min', num: true },
  { key: 'gameplay_cost_usd_per_hour', header: 'game $/hr', num: true },
  { key: 'error_rate', header: 'err', num: true },
  { key: 'source', header: 'source' },
];

const perfRows = perf.map((r) => ({
  sort: {
    model_id: r.model_id,
    provider_id: r.provider_id,
    latency_p50_ms: r.latency_p50_ms,
    latency_p95_ms: r.latency_p95_ms,
    tokens_per_sec_mean: r.tokens_per_sec_mean,
    ttft_p50_ms: r.ttft_p50_ms,
    usd_per_mtok_observed: r.usd_per_mtok_observed,
    gameplay_cost_usd_per_minute: r.gameplay_cost_usd_per_minute,
    gameplay_cost_usd_per_hour: r.gameplay_cost_usd_per_hour,
    error_rate: r.error_rate ?? 0,
    source: r.source ?? 'phase3',
  },
  html: {
    model_id: modelCell(r, base) + (r.is_local ? ` ${badge('local', 'local runtime')}` : ''),
    provider_id: badge(r.provider_id),
    latency_p50_ms: fmtInt(r.latency_p50_ms),
    latency_p95_ms: fmtInt(r.latency_p95_ms),
    tokens_per_sec_mean: fmt(r.tokens_per_sec_mean, 1),
    ttft_p50_ms: fmtInt(r.ttft_p50_ms),
    usd_per_mtok_observed: r.usd_per_mtok_observed != null ? `$${r.usd_per_mtok_observed}` : '—',
    gameplay_cost_usd_per_minute: fmtMoney(r.gameplay_cost_usd_per_minute),
    gameplay_cost_usd_per_hour: fmtMoneyHour(r.gameplay_cost_usd_per_hour),
    error_rate: fmtPct(r.error_rate ?? 0, 0),
    source: badge(r.source ?? 'phase3'),
  },
}));
---
<Base title="Rundale Bench — Perf matrix">
  <h2>Per-provider performance</h2>
  <p class="muted">
    Latency, throughput, price, and reliability per (model, provider). Quality
    is judged once on the cheapest provider — perf is measured independently
    so the leaderboard isn't biased by speed or price. <span class="badge">legacy</span>
    rows come from earlier OpenRouter sweeps (TTFT + total ms);
    <span class="badge">phase3</span> rows are the new harness (full latency + observed $/Mtok).
  </p>
  {profile && (
    <>
      <h3>Normal-play cost profile</h3>
      <p class="muted">
        Cost estimates use {fmt(profile.total_gameplay?.requests_per_minute, 2)} gameplay request(s)/minute,
        about {fmt(profile.total_gameplay?.input_tokens_per_minute_estimated)} input token(s)/minute and
        {fmt(profile.total_gameplay?.output_tokens_per_minute_estimated)} output token(s)/minute.
        The synthetic demo-player category is excluded. Source: <code>{profile.source}</code>.
      </p>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>Category</th><th class="num">req/min</th>
              <th class="num">input tok/req</th><th class="num">output tok/req</th>
              <th class="num">input tok/min</th><th class="num">output tok/min</th>
            </tr>
          </thead>
          <tbody>
            {profileRows.map((c) => (
              <tr>
                <td>{c.isTotal ? <strong>{c.label}</strong> : c.label}</td>
                <td class="num">{c.isTotal ? <strong>{fmt(c.requests_per_minute, 2)}</strong> : fmt(c.requests_per_minute, 2)}</td>
                <td class="num">{c.isTotal ? <strong>{fmt(c.input_tokens_per_request_estimated)}</strong> : fmt(c.input_tokens_per_request_estimated)}</td>
                <td class="num">{c.isTotal ? <strong>{fmt(c.output_tokens_per_request_estimated)}</strong> : fmt(c.output_tokens_per_request_estimated)}</td>
                <td class="num">{c.isTotal ? <strong>{fmt(c.input_tokens_per_minute_estimated)}</strong> : fmt(c.input_tokens_per_minute_estimated)}</td>
                <td class="num">{c.isTotal ? <strong>{fmt(c.output_tokens_per_minute_estimated)}</strong> : fmt(c.output_tokens_per_minute_estimated)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}
  {costExamples.length > 0 && (
    <>
      <h3>Catalog cloud cost examples</h3>
      <p class="muted">
        Examples combine the same normal-play profile with input/output prices from
        <code>rundale-bench/v1/models.toml</code>. Prices are point-in-time estimates; verify provider pricing before spending money. Click a column header to sort.
      </p>
      <SortableTable client:load columns={costColumns} rows={costRows} initialSort={{ key: 'gameplay_cost_usd_per_hour', dir: 1 }} />
    </>
  )}
  {perf.length === 0 ? (
    <div class="empty">No perf measurements yet.</div>
  ) : (
    <>
      <SortableTable client:load columns={perfColumns} rows={perfRows} initialSort={{ key: 'latency_p50_ms', dir: 1 }} />
    </>
  )}
</Base>
